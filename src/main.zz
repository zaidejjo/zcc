// zcc — blazing-fast code counter (tokei clone) in ZZ.
// Usage: zcc [path] [--format table|json] [--hidden] [--no-ignore] [--only LANG] [--help]
// NOTE: `zz build` cache-keys only the entry file — after editing any other
// module, change this file's bytes too (or the old binary is re-served).
// (Upstream cache-invalidation bug; entry rev 26.)
import std.fs
import std.json
import std.str
import std.sys
import std.task
import std.vec

import blame
import cache
import config
import counter
import diff
import languages
import parallel
import report
import walker

pub func VERSION() -> str {
    "0.1.0"
}

func noop() {
    
    
}

func print_help() {
    println("zcc {VERSION()} — code counter (tokei clone, ZZ native)")
    println("")
    println("USAGE:")
    println("    zcc [path] [flags]")
    println("    zcc init [--force]")
    println("")
    println("ARGS:")
    println("    [path]              directory or file (default: .)")
    println("")
    println("FLAGS:")
    println("    --format table|json   output as table (default) or machine-readable JSON")
    println("                          (--output is an alias)")
    println("    --hidden            include hidden files/dirs")
    println("    --no-ignore         skip .gitignore rules (still skips .git)")
    println("    --no-cache          skip the count cache (always recount)")
    println("    --only LANG         count only this language (e.g. Rust)")
    println("    --sort KEY          sort table by code|lines|files|comments|blanks (default code, desc; prefix - for asc)")
    println("    --reverse           ascending sort order")
    println("    --no-generated      hide Generated rows (totals recompute)")
    println("    --force             with init: overwrite existing config")
    println("    --by-file           list top files by lines after the table")
    println("    --top N             files shown with --by-file (default 20)")
    println("    --help, -h          show this help")
    println("    --version, -V       show version")
    println("")
    println("CONFIG:")
    println("    builtin languages.json + ~/.config/zcc/languages.json override")
    println("    (Linux/macOS) or %APPDATA%\\zcc\\languages.json (Windows)")
    println("    ~/.config/zcc/config.json: display theme + custom languages")
    println("      {\"display\": {\"color\": true, \"header\": \"cyan\",")
    println("       \"language\": \"green\", \"total\": \"cyan\",")
    println("       \"languages\": {\"Rust\": \"#ff5500\"}},")
    println("       \"languages\": {\"MyLang\": {\"extensions\": [\"myl\"],")
    println("        \"files\": [], \"line\": [\"#\"],")
    println("        \"block_start\": [\"/*\"], \"block_end\": [\"*/\"]}}}")
    println("")
    println("EXAMPLES:")
    println("    zcc init            write ~/.config/zcc/config.json")
    println("    zcc diff [BASE]     per-language added/removed vs BASE (default HEAD)")
    println("    zcc blame [path]    per-author line share via git blame")
    println("    zcc .")
    println("    zcc src/ --only Rust")
    println("    zcc . --output json > counts.json")
}

func main(cli_args: [str]) {
    // Hand-rolled flag parsing (robust vs leading "--" from `zz run --`).
    target := "."
    out_json := false
    out_next := false
    include_hidden := false
    use_ignore := true
    use_cache := true
    force := false
    by_file := false
    topn := 20
    top_next := false
    sort := "code"
    rev := false
    no_generated := false
    only := ""
    show_help := false
    show_ver := false
    for a in cli_args {
        if a == "--" {
            continue
        }
        if a == "--help" || a == "-h" {
            show_help = true
            continue
        }
        if a == "--version" || a == "-V" {
            show_ver = true
            continue
        }
        if a == "--hidden" {
            include_hidden = true
            continue
        }
        if a == "--no-ignore" {
            use_ignore = false
            continue
        }
        if a == "--no-cache" {
            use_cache = false
            continue
        }
        if a == "--force" {
            force = true
            continue
        }
        if a == "--by-file" {
            by_file = true
            continue
        }
        if str.starts_with(a, "--top=") {
            parts := str.split(a, "=")
            if len(parts) > 1 {
                topn = int(parts[1]) ?? 20
                if topn < 1 {
                    topn = 20
                }
            }
            continue
        }
        if a == "--top" {
            top_next = true
            continue
        }
        if a == "--output=json" || a == "--output json" {
            out_json = true
            continue
        }
        if a == "--output" || a == "--format" {
            out_next = true
            continue
        }
        if str.starts_with(a, "--output=") || str.starts_with(a, "--format=") {
            v := str.split(a, "=")[1]
            if v == "json" {
                out_json = true
            } else {
                if v == "table" {
                    out_json = false
                } else {
                    println("unknown output format: {v} (table|json)")
                }
            }
            out_next = false
            continue
        }
        if out_next {
            if a == "json" {
                out_json = true
            } else {
                if a == "table" {
                    out_json = false
                } else {
                    println("unknown output format: {a} (table|json)")
                }
            }
            out_next = false
            continue
        }
        if a == "json" && out_json {
            continue
        }
        if str.starts_with(a, "--sort=") {
            parts := str.split(a, "=")
            if len(parts) > 1 {
                v := parts[1]
                if str.starts_with(v, "-") {
                    rev = true
                    v = v[1:]
                }
                if v == "code" || v == "lines" || v == "files" || v == "comments" || v == "blanks" {
                    sort = v
                } else {
                    println("unknown --sort key: {v} (code|lines|files|comments|blanks)")
                }
            }
            continue
        }
        if a == "--reverse" {
            rev = true
            continue
        }
        if a == "--no-generated" {
            no_generated = true
            continue
        }
        if str.starts_with(a, "--only=") {
            parts := str.split(a, "=")
            if len(parts) > 1 {
                only = parts[1]
            }
            continue
        }
        if a == "--only" {
            only = "__NEXT__"
            continue
        }
        if only == "__NEXT__" {
            only = a
            continue
        }
        if top_next {
            topn = int(a) ?? 20
            if topn < 1 {
                topn = 20
            }
            top_next = false
            continue
        }
        if str.starts_with(a, "--") {
            println("unknown flag: {a} (see --help)")
            continue
        }
        // positional path (first wins)
        if target == "." {
            target = a
        }
    }
    // handle `--output json` split form: next token "json" after --output
    if show_help {
        print_help()
        return
    }
    if show_ver {
        println("zcc {VERSION()}")
        return
    }
    // init subcommand (exact word only: ./init still counts as a path)
    if target == "init" {
        println(config.init_config(languages.config_dir(), force))
        return
    }
    // diff subcommand: `zcc diff [BASE]` (default HEAD). The token after
    // `diff` is the base ref, not a path.
    if target == "diff" {
        base := "HEAD"
        for a in cli_args {
            if a == "diff" || a == "--" {
                continue
            }
            if str.starts_with(a, "--") {
                continue
            }
            if a != "." {
                base = a
                break
            }
        }
        diff.run_diff(base)
        return
    }
    // blame subcommand: `zcc blame [path]` (default .).
    if target == "blame" {
        broot := "."
        for a in cli_args {
            if a == "blame" || a == "--" {
                continue
            }
            if str.starts_with(a, "--") {
                continue
            }
            broot = a
            break
        }
        blame.run_blame(broot)
        return
    }
    // resolve target
    root := target
    if root == "" {
        root = "."
    }
    // single file mode
    if fs.exists(root) && fs.is_file(root) {
        run_single(root, only, out_json)
        return
    }
    if !fs.exists(root) {
        println("zcc: path not found: {root}")
        return
    }
    run_dir(root, only, out_json, include_hidden, use_ignore, use_cache, by_file, topn, sort, rev, no_generated)
}

func run_single(path: str, only: str, out_json: bool) {
    cfg := config.load_config()
    th := config.build_theme(cfg)
    table := config.lang_table_with(cfg)
    customs := config.custom_names(cfg)
    em := languages.build_ext_map(table)
    lang := languages.resolve_fast(em, path)
    if lang == "" {
        println("zcc: unknown language for {path}")
        return
    }
    if only != "" && only != "__NEXT__" && lang != only {
        println("zcc: {path} is {lang}, filtered by --only {only}")
        return
    }
    match fs.read_to_string(path) {
        .ok(text) => {
            if walker.has_nul(text) {
                println("zcc: skipping binary {path}")
                return
            }
            rules := languages.resolve_markers(table, lang, customs)
            c := counter.count_content_with(text, lang, rules[0], rule_str(rules[1]), rule_str(rules[2]))
            t := report.new_table()
            t = report.add_row(t, lang, 1, c.lines, c.code, c.comments, c.blanks)
            if out_json {
                println(report.to_json(t, report.new_table()))
            } else {
                report.print_table(t, th)
            }
        }
        .err(e) => println("zcc: cannot read {path}: {e}")
    }
}

func run_dir(root: str, only: str, out_json: bool, include_hidden: bool, use_ignore: bool, use_cache: bool, by_file: bool, topn: int, sort: str, rev: bool, no_generated: bool) {
    pats := walker.load_patterns(root)
    // Worker budget shared by walk fan-out and count fan-out below.
    nworkers := sys.cpu_count()
    if nworkers < 1 {
        nworkers = 1
    }
    if nworkers > parallel.worker_cap() {
        nworkers = parallel.worker_cap()
    }
    files := walker.walk_files_par(root, pats, use_ignore, include_hidden, nworkers)
    cfg := config.load_config()
    th := config.build_theme(cfg)
    table := config.lang_table_with(cfg)
    customs := config.custom_names(cfg)
    em := languages.build_ext_map(table)
    cached := json.null()
    cached_n := 0
    if use_cache {
        cached = cache.load_files_obj(root)
        if json.type(cached) == "object" {
            cached_n = json.len(cached)
        }
    }
    t := report.new_table()
    emb := report.new_table()
    saverows := []
    // per-file rows for --by-file (parallel arrays; aggregated above too)
    fpaths := []
    flangs := []
    flines := []
    fcode := []
    fcomments := []
    fblanks := []
    misses := 0
    counted := 0
    // Phase 1 (serial, zero big copies): cheap string-only resolve +
    // cache hits inline. Misses collect as plain range data only --
    // the opaque json table never crosses a spawn boundary.
    mpaths := []
    mlangs := []
    mshows := []
    msig0 := []
    msig1 := []
    mjoined := []
    mbstart := []
    mbend := []
    fpos := []
    // Per-lang rule memo: ~30 distinct langs over hundreds of files;
    // skips the repeated customs scan + table lookups per file.
    memo_lang := []
    memo_joined := []
    memo_b0 := []
    memo_b1 := []
    for f in files {
        // Cheap string-only checks first: zero IO for unknown/filtered-out.
        lang := languages.resolve_fast(em, f)
        if lang == "" {
            continue
        }
        if only != "" && only != "__NEXT__" && lang != only {
            continue
        }
        // Generated files aggregate under "Generated", never into
        // language totals (filtering above still uses the real language).
        show := lang
        if walker.is_generated(f) {
            show = "Generated"
        }
        sig := cache.current_sig(f)
        hit := false
        if use_cache && sig[0] != "" {
            e := cache.lookup_entry(cached, f)
            if json.type(e) == "object" {
                if cache.entry_str(e, "mtime") == sig[0] && cache.entry_str(e, "size") == sig[1] && cache.entry_str(e, "lang") == show {
                    li := cache.entry_int(e, "lines")
                    co := cache.entry_int(e, "code")
                    cm := cache.entry_int(e, "comments")
                    bl := cache.entry_int(e, "blanks")
                    if li >= 0 && co >= 0 && cm >= 0 && bl >= 0 {
                        t = report.add_row(t, show, 1, li, co, cm, bl)
                        embval := cache.entry_json(e, "emb")
                        emb = cache.merge_emb_val(emb, embval)
                        counted = counted + 1
                        saverows = vec.push(saverows, cache.enc_entry_arr(f, sig[0], sig[1], show, li, co, cm, bl, cache.emb_array_joins(embval)))
                        if by_file {
                            fpaths = vec.push(fpaths, f)
                            flangs = vec.push(flangs, show)
                            flines = vec.push(flines, li)
                            fcode = vec.push(fcode, co)
                            fcomments = vec.push(fcomments, cm)
                            fblanks = vec.push(fblanks, bl)
                        }
                        hit = true
                    }
                }
            }
        }
        if hit {
            continue
        }
        mpaths = vec.push(mpaths, f)
        mlangs = vec.push(mlangs, lang)
        mshows = vec.push(mshows, show)
        msig0 = vec.push(msig0, sig[0])
        msig1 = vec.push(msig1, sig[1])
        mj := ""
        b0 := ""
        b1 := ""
        rule_hit := false
        for q in 0..len(memo_lang) {
            if memo_lang[q] == lang {
                mj = memo_joined[q]
                b0 = memo_b0[q]
                b1 = memo_b1[q]
                rule_hit = true
                break
            }
        }
        if !rule_hit {
            rules := languages.resolve_markers(table, lang, customs)
            mj = str.join(rules[0], "\x01")
            b0 = rule_str(rules[1])
            b1 = rule_str(rules[2])
            memo_lang = vec.push(memo_lang, lang)
            memo_joined = vec.push(memo_joined, mj)
            memo_b0 = vec.push(memo_b0, b0)
            memo_b1 = vec.push(memo_b1, b1)
        }
        mjoined = vec.push(mjoined, mj)
        mbstart = vec.push(mbstart, b0)
        mbend = vec.push(mbend, b1)
        // Placeholder row keeps walk order: counts filled in phase 2.
        if by_file {
            fpaths = vec.push(fpaths, f)
            flangs = vec.push(flangs, show)
            flines = vec.push(flines, 0)
            fcode = vec.push(fcode, 0)
            fcomments = vec.push(fcomments, 0)
            fblanks = vec.push(fblanks, 0)
            fpos = vec.push(fpos, len(fpaths) - 1)
        } else {
            fpos = vec.push(fpos, -1)
        }
    }
    misses = len(mpaths)
    // Phase 2: recount misses. Small trees stay serial (spawn + snapshot
    // cost more than they save); big cold trees fan out over green
    // threads, one chunk per worker, joined in order (deterministic).
    if misses > 0 && misses < parallel.par_threshold() {
        // Same worker body, called directly: no spawn overhead, one
        // counting implementation for both paths.
        res := parallel.count_files(mpaths, mlangs, mshows, mjoined, mbstart, mbend, 0, len(mpaths))
        for j in 0..len(res.oks) {
            if res.oks[j] == 0 {
                continue
            }
            show := mshows[j]
            if res.gens[j] == 1 {
                show = "Generated"
            }
            t = report.add_row(t, show, 1, res.lines[j], res.code[j], res.comments[j], res.blanks[j])
            counted = counted + 1
            if by_file {
                p := fpos[j]
                flangs[p] = show
                flines[p] = res.lines[j]
                fcode[p] = res.code[j]
                fcomments[p] = res.comments[j]
                fblanks[p] = res.blanks[j]
            }
            if report.has_emb(mlangs[j]) && show == mlangs[j] {
                emb = cache.merge_emb_enc(emb, res.fencs[j])
            }
            if use_cache {
                saverows = vec.push(saverows, cache.enc_entry(mpaths[j], msig0[j], msig1[j], show, res.lines[j], res.code[j], res.comments[j], res.blanks[j], res.fencs[j]))
            }
        }
    }
    if misses >= parallel.par_threshold() {
        // One chunk per core: warm runs are CPU-bound and chunky enough
        // that this is the sweet spot; cold runs still overlap IO because
        // blocking reads park a worker while the pool tops itself up.
        if nworkers > misses {
            nworkers = misses
        }
        chunk := (misses + nworkers - 1) / nworkers
        starts := []
        ends := []
        s := 0
        while s < misses {
            e := s + chunk
            if e > misses {
                e = misses
            }
            starts = vec.push(starts, s)
            ends = vec.push(ends, e)
            s = e
        }
        hs := []
        for k in 0..len(starts) {
            cs := starts[k]
            ce := ends[k]
            hs = vec.push(hs, task.spawn(|_| {
                parallel.count_files(mpaths, mlangs, mshows, mjoined, mbstart, mbend, cs, ce)
            }))
        }
        for k in 0..len(hs) {
            res:parallel.ChunkOut = task.join(hs[k])
            base := starts[k]
            for j in 0..len(res.oks) {
                if res.oks[j] == 0 {
                    continue
                }
                idx := base + j
                show := mshows[idx]
                if res.gens[j] == 1 {
                    show = "Generated"
                }
                t = report.add_row(t, show, 1, res.lines[j], res.code[j], res.comments[j], res.blanks[j])
                counted = counted + 1
                if by_file {
                    p := fpos[idx]
                    flangs[p] = show
                    flines[p] = res.lines[j]
                    fcode[p] = res.code[j]
                    fcomments[p] = res.comments[j]
                    fblanks[p] = res.blanks[j]
                }
                if report.has_emb(mlangs[idx]) && show == mlangs[idx] {
                    emb = cache.merge_emb_enc(emb, res.fencs[j])
                }
                if use_cache {
                    saverows = vec.push(saverows, cache.enc_entry(mpaths[idx], msig0[idx], msig1[idx], show, res.lines[j], res.code[j], res.comments[j], res.blanks[j], res.fencs[j]))
                }
            }
        }
    }
    // Clean warm runs skip the rewrite: rows round-tripped untouched,
    // so the file on disk is already identical (saves join + write).
    // Filtered views (e.g. --only/--hidden) never save: the cache keys by
    // root only, and a partial row set would poison full runs. They still
    // read (misses count fresh, results stay correct).
    can_save := use_cache && only == "" && !include_hidden && use_ignore
    if can_save && (misses > 0 || len(saverows) != cached_n) {
        cache.save_cache(root, saverows)
    }
    if counted == 0 {
        println("zcc: no countable files under {root}")
        return
    }
    if no_generated {
        t = report.filter_lang(t, "Generated")
        if by_file {
            fp := []
            fl := []
            fn_ := []
            fc := []
            fm := []
            fb := []
            for k in 0..len(fpaths) {
                if flangs[k] == "Generated" {
                    continue
                }
                fp = vec.push(fp, fpaths[k])
                fl = vec.push(fl, flangs[k])
                fn_ = vec.push(fn_, flines[k])
                fc = vec.push(fc, fcode[k])
                fm = vec.push(fm, fcomments[k])
                fb = vec.push(fb, fblanks[k])
            }
            fpaths = fp
            flangs = fl
            flines = fn_
            fcode = fc
            fcomments = fm
            fblanks = fb
        }
    }
    if out_json {
        if by_file {
            println(report.to_json_full(t, emb, fpaths, flangs, flines, fcode, fcomments, fblanks, topn))
        } else {
            println(report.to_json(t, emb))
        }
    } else {
        report.print_table_full(t, emb, th, sort, rev)
        if by_file {
            report.print_files_section(root, fpaths, flangs, flines, fcode, fcomments, fblanks, topn, th)
        }
    }
}

// First element or "" (block start/end singletons from resolve_markers).

pub func rule_str(xs: [str]) -> str {
    if len(xs) > 0 {
        return xs[0]
    }
    ""
}
