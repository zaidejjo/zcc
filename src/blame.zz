// zcc/src/blame.zz — per-author line attribution via `git blame`.
//
// `zcc blame [path]`: walks countable files (same resolver as counting),
// runs `git blame --line-porcelain` per file, and aggregates lines per
// author. Untracked/unblamable files are skipped and reported as a single
// "(uncommitted)" bucket so totals stay honest. One git process per file
// (v1 simplicity — ~5ms spawn; big trees take seconds, still faster than
// a human reading the log).
import std.process
import std.str
import std.vec

import config
import languages
import report
import walker

pub struct BlameStat {
    name: str,
    files: int,
    lines: int,
}

pub func run_blame(root: str) {
    pats := walker.load_patterns(root)
    files := walker.walk_files(root, pats, true, false)
    cfg := config.load_config()
    table := config.lang_table_with(cfg)
    em := languages.build_ext_map(table)
    names := []
    nfiles := []
    nlines := []
    skipped := 0
    for f in files {
        lang := languages.resolve_fast(em, f)
        if lang == "" {
            continue
        }
        show := lang
        if walker.is_generated(f) {
            show = "Generated"
        }
        authors := blame_file(f)
        if len(authors) == 0 {
            skipped = skipped + 1
            continue
        }
        seen := []
        for a in authors {
            hit := -1
            for q in 0..len(names) {
                if names[q] == a {
                    hit = q
                    break
                }
            }
            if hit < 0 {
                names = vec.push(names, a)
                nfiles = vec.push(nfiles, 0)
                nlines = vec.push(nlines, 0)
                hit = len(names) - 1
            }
            nlines[hit] = nlines[hit] + 1
            first := true
            for s in seen {
                if s == hit {
                    first = false
                    break
                }
            }
            if first {
                seen = vec.push(seen, hit)
                nfiles[hit] = nfiles[hit] + 1
            }
        }
    }
    total := 0
    for x in nlines {
        total = total + x
    }
    if total == 0 {
        println("zcc: nothing blamable under {root} ({skipped} skipped)")
        return
    }
    bar := "────────────────────────────────────────────────────────────────"
    println(bar)
    h1 := report.pad_r("Author", 24)
    h2 := report.pad_l("Files", 8)
    h3 := report.pad_l("Lines", 10)
    h4 := report.pad_l("Share", 10)
    println("{h1}{h2}{h3}{h4}")
    println(bar)
    order := report.top_by_lines(nlines, len(nlines))
    for k in order {
        share := 0
        if total > 0 {
            share = nlines[k] * 100 / total
        }
        c1 := report.pad_r(names[k], 24)
        c2 := report.pad_l(str(nfiles[k]), 8)
        c3 := report.pad_l(str(nlines[k]), 10)
        c4 := report.pad_l(str(share) + "%", 10)
        println("{c1}{c2}{c3}{c4}")
    }
    println(bar)
    if skipped > 0 {
        println("{skipped} unblamable files skipped (untracked or binary)")
    }
}

// Authors per line (porcelain author lines, in file order). Empty when
// git fails (untracked file, not a repo, binary).

func blame_file(path: str) -> [str] {
    out := []
    match process.run("git", ["blame", "--line-porcelain", path]) {
        .err(_) => {
            return out
        }
        .ok(t) => {
            if t[0] != 0 {
                return out
            }
            out = parse_blame_authors(t[1])
        }
    }
    out
}

// Porcelain `author ` lines to names, in file order. Pure (unit-tested).

pub func parse_blame_authors(text: str) -> [str] {
    out := []
    for raw in str.split(text, "\n") {
        if str.starts_with(raw, "author ") {
            parts := str.split(raw, " ")
            if len(parts) > 1 {
                name := join_rest(parts, 1)
                out = vec.push(out, name)
            }
        }
    }
    out
}

func join_rest(parts: [str], from: int) -> str {
    out := ""
    first := true
    for i in from..len(parts) {
        if first {
            out = parts[i]
            first = false
        } else {
            out = out + " " + parts[i]
        }
    }
    out
}
