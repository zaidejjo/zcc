// zcc/src/counter.zz — single-pass line counter.
// Handles: blanks, line comments, block comments (nest-aware for Rust-style),
// triple-quote doc strings (Python), Markdown fenced embeds.
import std.str
import std.vec

import languages

pub struct Counts {
    files: int,
    lines: int,
    code: int,
    comments: int,
    blanks: int,
}

pub func zero() -> Counts {
    Counts{files: 0, lines: 0, code: 0, comments: 0, blanks: 0}
}

pub func split_lines(content: str) -> [str] {
    if content == "" {
        return []
    }
    lines := str.split(content, "\n")
    // Drop artifact empty from trailing newline ("a\n" -> ["a", ""]).
    if len(lines) > 0 && lines[len(lines) - 1] == "" {
        lines = lines[:len(lines) - 1]
    }
    lines
}

pub func is_blank(s: str) -> bool {
    str.trim(s) == ""
}

// True when blanking strings could change classification: line has a
// comment marker or block opener AND a quote. Marker-first: plain code
// lines (the majority) exit after 1-2 native scans without touching
// quotes; quote scans run only when blanking might matter.

pub func needs_strip(line: str, markers: [str], has_bstart: bool) -> bool {
    if !has_bstart {
        found := false
        for m in markers {
            if m != "" && str.contains(line, m) {
                found = true
                break
            }
        }
        if !found {
            return false
        }
    }
    str.contains(line, "\"") || str.contains(line, "'") || str.contains(line, "`")
}

pub func starts_with_any(s: str, markers: [str]) -> bool {
    for m in markers {
        if m != "" && str.starts_with(s, m) {
            return true
        }
    }
    false
}

// Blank string literals using native split/join (bulk C speed).
// Same toggle semantics as the old per-char stripper (including the
// apostrophe quirk), but segment loops instead of char loops:
// O(segments) interpreted iterations, heavy lifting in Rust/C.

pub func blank_quote(line: str, q: str) -> str {
    esc := "\\" + q
    s := str.replace(line, "\\\\", "  ")
    s = str.replace(s, esc, "  ")
    parts := str.split(s, q)
    if len(parts) <= 1 {
        return s
    }
    out := parts[0]
    for i in 1..len(parts) {
        if i % 2 == 1 {
            out = out + q + str.repeat(" ", len(parts[i]))
        } else {
            out = out + q + parts[i]
        }
    }
    out
}

pub func blank_strings(line: str) -> str {
    s := blank_quote(line, "\"")
    s = blank_quote(s, "`")
    s = blank_quote(s, "'")
    s
}

pub func count_content(content: str, lang: str) -> Counts {
    markers := languages.line_markers(lang)
    pair := languages.block_pair(lang)
    bstart := ""
    bend := ""
    if len(pair) == 2 {
        bstart = pair[0]
        bend = pair[1]
    }
    count_content_with(content, lang, markers, bstart, bend)
}

// Same count with pre-resolved rules (custom languages via table).
// Callers pass resolve_markers(table, lang) unpacked.

pub func count_content_with(content: str, lang: str, markers: [str], bstart: str, bend: str) -> Counts {
    c := zero()
    nlines := 0
    ncode := 0
    ncomments := 0
    nblanks := 0
    // Markdown: code fences switch embedded language; prose counts as comments
    // (matches tokei: Markdown row shows comments+blanks, code in child rows).
    if lang == "Markdown" {
        return count_markdown(content)
    }
    // Fast path: no comment syntax at all (Json, Text, etc).
    // Avoids per-char string stripping which is O(n^2) on minified single-line files.
    if len(markers) == 0 && bstart == "" {
        lines := split_lines(content)
        for raw in lines {
            c.lines = c.lines + 1
            if str.trim(raw) == "" {
                c.blanks = c.blanks + 1
            } else {
                c.code = c.code + 1
            }
        }
        c.files = 1
        return c
    }
    // Ruby =begin/=end && Perl =cut are whole-line blocks.
    whole_line_block := lang == "Ruby" || lang == "Perl"
    lines := split_lines(content)
    in_block := false
    depth := 0
    nested := lang == "Rust" || lang == "Swift" || lang == "Julia"
    for raw in lines {
        nlines = nlines + 1
        if raw == "" {
            nblanks = nblanks + 1
            continue
        }
        t := str.trim(raw)
        if t == "" {
            nblanks = nblanks + 1
            continue
        }
        if whole_line_block {
            if t == bstart {
                in_block = true
                ncomments = ncomments + 1
                continue
            }
            if t == bend {
                in_block = false
                ncomments = ncomments + 1
                continue
            }
            if in_block {
                ncomments = ncomments + 1
                continue
            }
            if starts_with_any(t, markers) {
                ncomments = ncomments + 1
            } else {
                ncode = ncode + 1
            }
            continue
        }
        // Inside block comment: look for end (nest-aware).
        if in_block {
            cleaned := raw
            has_open := bstart != "" && str.contains(raw, bstart)
            if needs_strip(raw, markers, has_open) {
                cleaned = blank_strings(raw)
            }
            if nested {
                // str.count is one native split per call (Rust speed);
                // the old while split/join loop re-scanned per occurrence.
                si := str.count(cleaned, bstart)
                ei := str.count(cleaned, bend)
                depth = depth + si - ei
                if depth <= 0 {
                    in_block = false
                    depth = 0
                }
            } else {
                if str.contains(cleaned, bend) {
                    in_block = false
                    // trailing code after */ counts as code
                    after := str.split(cleaned, bend)
                    tail := str.trim(after[len(after) - 1])
                    if tail != "" && !starts_with_any(t, markers) {
                        // mixed line: count as code (tokei counts code-biased)
                        ncode = ncode + 1
                        continue
                    }
                }
            }
            ncomments = ncomments + 1
            continue
        }
        // Line comment at start (after trim)?
        if starts_with_any(t, markers) {
            ncomments = ncomments + 1
            continue
        }
        // Block start on this line? Gate on the raw line first: strip +
        // split cost nothing when no opener is present (the common case),
        // and blanking cannot create an opener, so the split below sees
        // the same opener exactly when the raw line has one.
        if bstart != "" && str.contains(raw, bstart) {
            cleaned := raw
            if needs_strip(raw, markers, true) {
                cleaned = blank_strings(raw)
            }
            if !str.contains(cleaned, bstart) {
                // Opener lived inside a string literal: not a block line.
                // A leading line-comment was ruled out above, so this is
                // code (matches the old fallthrough: the commented-check
                // below always finds code here — quote remnants never
                // trim empty — and no block opens without an opener).
                ncode = ncode + 1
                continue
            }
            idx_parts := str.split(cleaned, bstart)
            before := str.trim(idx_parts[0])
            // Opener sitting inside a line comment (`code // /*`)?
            // Then no block opens: classify by code before the marker.
            commented := false
            commented_code := false
            for m in markers {
                if m != "" && str.contains(before, m) {
                    commented = true
                    seg := str.split(before, m)[0]
                    if str.trim(seg) != "" {
                        commented_code = true
                    }
                }
            }
            if commented {
                if commented_code {
                    ncode = ncode + 1
                } else {
                    ncomments = ncomments + 1
                }
                continue
            }
            if bend != "" && str.contains(cleaned, bend) {
                // inline block on one line: check code before start
                if before == "" {
                    ncomments = ncomments + 1
                } else {
                    ncode = ncode + 1
                }
                continue
            }
            // multi-line block opens
            in_block = true
            depth = 1
            if before == "" || starts_with_any(t, markers) {
                ncomments = ncomments + 1
            } else {
                ncode = ncode + 1
            }
            continue
        }
        // Anything left uncommented on the line is code.
        ncode = ncode + 1
    }
    c.lines = nlines
    c.code = ncode
    c.comments = ncomments
    c.blanks = nblanks
    c.files = 1
    c
}

// Markdown: prose -> comments, fences -> embedded code counted via child map.
// We return prose counts here; main.zz attributes fence blocks to inner langs
// by re-running count_content on fence bodies.

pub func count_markdown(content: str) -> Counts {
    c := zero()
    lines := split_lines(content)
    in_fence := false
    for raw in lines {
        c.lines = c.lines + 1
        t := str.trim(raw)
        if str.starts_with(t, "```") {
            if in_fence {
                in_fence = false
            } else {
                in_fence = true
            }
            c.comments = c.comments + 1
            continue
        }
        if in_fence {
            // fence body lines are code of embedded lang; count as code here
            // too so Markdown total lines balance, then main re-attributes.
            if t == "" {
                c.blanks = c.blanks + 1
            } else {
                c.code = c.code + 1
            }
            continue
        }
        if t == "" {
            c.blanks = c.blanks + 1
        } else {
            c.comments = c.comments + 1
        }
    }
    c.files = 1
    c
}

// Extract fenced blocks: returns parallel arrays [lang, body].

pub func markdown_fences(content: str) -> [str] {
    langs := []
    bodies := []
    lines := split_lines(content)
    in_fence := false
    cur_lang := ""
    cur := ""
    for raw in lines {
        t := str.trim(raw)
        if str.starts_with(t, "```") {
            if in_fence {
                langs = vec.push(langs, cur_lang)
                bodies = vec.push(bodies, cur)
                cur = ""
                cur_lang = ""
                in_fence = false
            } else {
                tag := str.trim(str.split(t, "```")[1] ?? "")
                // normalize fence tags to zcc language names
                if tag == "bash" || tag == "sh" || tag == "shell" {
                    tag = "BASH"
                }
                if tag == "rust" {
                    tag = "Rust"
                }
                if tag == "python" || tag == "py" {
                    tag = "Python"
                }
                if tag == "toml" {
                    tag = "TOML"
                }
                if tag == "lua" {
                    tag = "Lua"
                }
                if tag == "js" || tag == "javascript" {
                    tag = "JavaScript"
                }
                if tag == "ts" || tag == "typescript" {
                    tag = "TypeScript"
                }
                cur_lang = tag
                in_fence = true
            }
            continue
        }
        if in_fence {
            cur = cur + raw + "\n"
        }
    }
    out := []
    out = vec.push(out, str.join(langs, "\x01"))
    out = vec.push(out, str.join(bodies, "\x02"))
    out
}
