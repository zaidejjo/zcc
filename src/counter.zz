// zcc/src/counter.zz — single-pass line counter.
// Handles: blanks, line comments, block comments (nest-aware for Rust-style),
// triple-quote doc strings (Python), Markdown fenced embeds.
import std.str
import std.vec

import languages

pub struct Counts {
    files: int,
    lines: int,
    code: int,
    comments: int,
    blanks: int,
}

pub func zero() -> Counts {
    Counts{files: 0, lines: 0, code: 0, comments: 0, blanks: 0}
}

pub func split_lines(content: str) -> [str] {
    if content == "" {
        return []
    }
    lines := str.split(content, "\n")
    // Drop artifact empty from trailing newline ("a\n" -> ["a", ""]).
    if len(lines) > 0 && lines[len(lines) - 1] == "" {
        lines = lines[:len(lines) - 1]
    }
    lines
}

pub func count_content(content: str, lang: str) -> Counts {
    markers := languages.line_markers(lang)
    pair := languages.block_pair(lang)
    bstart := ""
    bend := ""
    if len(pair) == 2 {
        bstart = pair[0]
        bend = pair[1]
    }
    count_content_with(content, lang, markers, bstart, bend)
}

// Same count with pre-resolved rules (custom languages via table).
// Callers pass resolve_markers(table, lang) unpacked.
//
// Single native call: str.classify runs the whole line loop in Rust/C
// (one interpreter-boundary crossing per file instead of per line) and
// returns [lines, code, comments, blanks]. Markdown keeps its ZZ loop
// (fence tracking + re-attribution live here, not in the primitive).

pub func count_content_with(content: str, lang: str, markers: [str], bstart: str, bend: str) -> Counts {
    if lang == "Markdown" {
        return count_markdown(content)
    }
    nested := lang == "Rust" || lang == "Swift" || lang == "Julia"
    whole := lang == "Ruby" || lang == "Perl"
    r := str.classify(content, markers, bstart, bend, nested, whole)
    c := zero()
    c.files = 1
    c.lines = r[0]
    c.code = r[1]
    c.comments = r[2]
    c.blanks = r[3]
    c
}

// Markdown: prose -> comments, fences -> embedded code counted via child map.
// We return prose counts here; main.zz attributes fence blocks to inner langs
// by re-running count_content on fence bodies.

pub func count_markdown(content: str) -> Counts {
    c := zero()
    lines := split_lines(content)
    in_fence := false
    for raw in lines {
        c.lines = c.lines + 1
        t := str.trim(raw)
        if str.starts_with(t, "```") {
            if in_fence {
                in_fence = false
            } else {
                in_fence = true
            }
            c.comments = c.comments + 1
            continue
        }
        if in_fence {
            // fence body lines are code of embedded lang; count as code here
            // too so Markdown total lines balance, then main re-attributes.
            if t == "" {
                c.blanks = c.blanks + 1
            } else {
                c.code = c.code + 1
            }
            continue
        }
        if t == "" {
            c.blanks = c.blanks + 1
        } else {
            c.comments = c.comments + 1
        }
    }
    c.files = 1
    c
}

// Extract fenced blocks: returns parallel arrays [lang, body].

pub func markdown_fences(content: str) -> [str] {
    langs := []
    bodies := []
    lines := split_lines(content)
    in_fence := false
    cur_lang := ""
    cur := ""
    for raw in lines {
        t := str.trim(raw)
        if str.starts_with(t, "```") {
            if in_fence {
                langs = vec.push(langs, cur_lang)
                bodies = vec.push(bodies, cur)
                cur = ""
                cur_lang = ""
                in_fence = false
            } else {
                tag := str.trim(str.split(t, "```")[1] ?? "")
                // normalize fence tags to zcc language names
                if tag == "bash" || tag == "sh" || tag == "shell" {
                    tag = "BASH"
                }
                if tag == "rust" {
                    tag = "Rust"
                }
                if tag == "python" || tag == "py" {
                    tag = "Python"
                }
                if tag == "toml" {
                    tag = "TOML"
                }
                if tag == "lua" {
                    tag = "Lua"
                }
                if tag == "js" || tag == "javascript" {
                    tag = "JavaScript"
                }
                if tag == "ts" || tag == "typescript" {
                    tag = "TypeScript"
                }
                cur_lang = tag
                in_fence = true
            }
            continue
        }
        if in_fence {
            cur = cur + raw + "\n"
        }
    }
    out := []
    out = vec.push(out, str.join(langs, "\x01"))
    out = vec.push(out, str.join(bodies, "\x02"))
    out
}
