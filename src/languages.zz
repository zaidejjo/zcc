// zcc/src/languages.zz — language detection + comment rules.
// Customizable: edit languages.json in repo root (devs) or
// ~/.config/zcc/languages.json (users, overrides builtin).
// Runtime lookup tries user config first, falls back to builtins below.
import std.env
import std.fs
import std.json
import std.str
import std.vec

// ── Config paths (cross-platform) ────────────────────────────────────────────

pub func config_dir() -> str {
    match env.home_dir() {
        .some(h) => {
            os := env.os()
            if os == "windows" {
                match env.get("APPDATA") {
                    .some(a) => a + "\\zcc"
                    .none => h + "\\.config\\zcc"
                }
            } else {
                h + "/.config/zcc"
            }
        }
        .none => "."
    }
}

pub func user_languages_path() -> str {
    dir := config_dir()
    os := env.os()
    if os == "windows" {
        dir + "\\languages.json"
    } else {
        dir + "/languages.json"
    }
}

// ── Builtin detection (fallback when JSON missing) ───────────────────────────

pub func detect_lang(path: str) -> str {
    base := fs.basename(path)
    // Exact filenames first (no extension).
    if base == "Makefile" {
        return "Makefile"
    }
    if base == "makefile" {
        return "Makefile"
    }
    if base == "GNUmakefile" {
        return "Makefile"
    }
    if base == "Dockerfile" {
        return "Dockerfile"
    }
    if base == "dockerfile" {
        return "Dockerfile"
    }
    if base == "CMakeLists.txt" {
        return "CMake"
    }
    if base == "Gemfile" {
        return "Ruby"
    }
    if base == "Rakefile" {
        return "Ruby"
    }
    if base == ".bashrc" {
        return "Bash"
    }
    if base == ".zshrc" {
        return "Zsh"
    }
    if base == ".vimrc" {
        return "VimScript"
    }
    ext := str.to_lower(fs.extension(path))
    if ext == "zz" {
        return "ZZ"
    }
    if ext == "rs" {
        return "Rust"
    }
    if ext == "py" || ext == "pyw" {
        return "Python"
    }
    if ext == "js" || ext == "mjs" || ext == "cjs" {
        return "JavaScript"
    }
    if ext == "ts" || ext == "mts" || ext == "cts" {
        return "TypeScript"
    }
    if ext == "tsx" {
        return "Tsx"
    }
    if ext == "jsx" {
        return "Jsx"
    }
    if ext == "go" {
        return "Go"
    }
    if ext == "c" {
        return "C"
    }
    if ext == "h" {
        return "CHeader"
    }
    if ext == "cpp" || ext == "cc" || ext == "cxx" || ext == "c++" || ext == "cp" {
        return "Cpp"
    }
    if ext == "hpp" || ext == "hh" || ext == "hxx" {
        return "CppHeader"
    }
    if ext == "cs" {
        return "CSharp"
    }
    if ext == "java" {
        return "Java"
    }
    if ext == "kt" || ext == "kts" {
        return "Kotlin"
    }
    if ext == "swift" {
        return "Swift"
    }
    if ext == "rb" {
        return "Ruby"
    }
    if ext == "erb" {
        return "RubyHtml"
    }
    if ext == "php" {
        return "Php"
    }
    if ext == "pl" || ext == "pm" {
        return "Perl"
    }
    if ext == "p6" || ext == "pm6" || ext == "raku" {
        return "Perl6"
    }
    if ext == "sh" || ext == "bash" {
        return "Bash"
    }
    if ext == "zsh" {
        return "Zsh"
    }
    if ext == "fish" {
        return "Fish"
    }
    if ext == "csh" {
        return "CShell"
    }
    if ext == "nu" {
        return "Nushell"
    }
    if ext == "ps1" || ext == "psm1" || ext == "psd1" {
        return "PowerShell"
    }
    if ext == "lua" {
        return "Lua"
    }
    if ext == "r" {
        return "R"
    }
    if ext == "jl" {
        return "Julia"
    }
    if ext == "dart" {
