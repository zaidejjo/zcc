// ── Comment rules per language ───────────────────────────────────────────────
// Returns line markers joined by \x01, block pair as [start, end].

pub func line_markers(lang: str) -> [str] {
    if lang == "ZZ" {
        return ["//", "#"]
    }
    if lang == "Rust" || lang == "Go" || lang == "C" || lang == "CHeader" || lang == "Cpp" || lang == "CppHeader" || lang == "CSharp" || lang == "Java" || lang == "Kotlin" || lang == "Swift" || lang == "Dart" || lang == "Scala" || lang == "Zig" {
        return ["//"]
    }
    if lang == "JavaScript" || lang == "TypeScript" || lang == "Jsx" || lang == "Tsx" || lang == "Qml" || lang == "Cuda" || lang == "Cython" {
        return ["//"]
    }
    if lang == "Python" || lang == "Bash" || lang == "Zsh" || lang == "Fish" || lang == "Nushell" || lang == "CShell" || lang == "Ruby" || lang == "Perl" || lang == "Perl6" || lang == "R" || lang == "Julia" || lang == "Nim" || lang == "Yaml" || lang == "Toml" || lang == "Makefile" || lang == "CMake" || lang == "Dockerfile" || lang == "Elixir" || lang == "Jq" || lang == "CoffeeScript" || lang == "D" || lang == "D2" {
        return ["#"]
    }
    if lang == "Php" {
        return ["//", "#"]
    }
    if lang == "Lua" || lang == "Sql" {
        return ["--"]
    }
    if lang == "Assembly" {
        return [";", "#", "//"]
    }
    if lang == "AutoHotKey" {
        return [";"]
    }
    if lang == "Erlang" {
        return ["%"]
    }
    if lang == "VimScript" {
        return ["\""]
    }
    if lang == "VB6" || lang == "VBScript" {
        return ["'"]
    }
    if lang == "LLVM" {
        return [";"]
    }
    if lang == "FSharp" {
        return ["//"]
    }
    if lang == "PowerShell" {
        return ["#"]
    }
    if lang == "GdScript" {
        return ["#"]
    }
    if lang == "GdShader" || lang == "ObjectiveC" || lang == "ObjectiveCpp" || lang == "Pascal" || lang == "OCaml" {
        return ["//"]
    }
    if lang == "WebAssembly" {
        return [";;"]
    }
    if lang == "D" {
        return ["//"]
    }
    []
}

pub func block_pair(lang: str) -> [str] {
    if lang == "Html" || lang == "Xml" || lang == "Svg" || lang == "Vue" || lang == "Svelte" || lang == "Astro" {
        return ["<!--", "-->"]
    }
    if lang == "Css" {
        return ["/*", "*/"]
    }
    if lang == "OCaml" {
        return ["(*", "*)"]
    }
    if lang == "FSharp" {
        return ["(*", "*)"]
    }
    if lang == "Lua" {
        return ["--[[", "]]"]
    }
    if lang == "Julia" {
        return ["#=", "=#"]
    }
    if lang == "Nim" {
        return ["#[", "]#"]
    }
    if lang == "Python" || lang == "Cython" || lang == "GdScript" {
        return ["\"\"\"", "\"\"\""]
    }
    if lang == "Ruby" {
        return ["=begin", "=end"]
    }
    if lang == "RubyHtml" {
        return ["<%", "%>"]
    }
    if lang == "Pascal" {
        return ["{", "}"]
    }
    if lang == "Perl" {
        return ["=cut", "=cut"]
    }
    if lang == "Perl6" {
        return ["#=", "=#"]
    }
    if lang == "PowerShell" {
        return ["<#", "#>"]
    }
    if lang == "CMake" {
        return ["#[[", "]]"]
    }
    if lang == "CoffeeScript" {
        return ["###", "###"]
    }
    if lang == "WebAssembly" {
        return ["(;", ";)"]
    }
    if lang == "Text" || lang == "Json" || lang == "Markdown" {
        return []
    }
    if lang == "Bash" || lang == "Zsh" || lang == "Fish" || lang == "Nushell" || lang == "CShell" || lang == "Makefile" || lang == "Dockerfile" || lang == "Yaml" || lang == "Toml" || lang == "Elixir" || lang == "Erlang" || lang == "Jq" || lang == "R" || lang == "VimScript" || lang == "VB6" || lang == "VBScript" || lang == "LLVM" || lang == "Zig" {
        return []
    }
    // C-family default.
    ["/*", "*/"]
}

// ── JSON override (user customization) ───────────────────────────────────────
// Best-effort: returns "" when no custom file || lookup fails.

pub func noop() {
    
    
}

pub func json_lookup_lang(path: str) -> str {
    upath := user_languages_path()
    if !fs.exists(upath) {
        if !fs.exists("languages.json") {
            return ""
        }
        return json_file_lookup("languages.json", path)
    }
    json_file_lookup(upath, path)
}

// Load + parse the language table ONCE. Returns json.null() when no
// config exists or parsing fails. Callers pass the result to
// resolve_lang_with per file — previously every file re-read and
// re-parsed languages.json (2 stats + full read + parse per file).

pub func load_lang_table() -> json {
    upath := user_languages_path()
    cfg := ""
    if fs.exists(upath) {
        cfg = upath
    }
    if cfg == "" && fs.exists("languages.json") {
        cfg = "languages.json"
    }
    if cfg == "" {
        return json.null()
    }
    match fs.read_to_string(cfg) {
        .ok(text) => {
            match json.parse(text) {
                .ok(root) => {
                    if json.type(root) != "object" {
                        return json.null()
                    }
                    root
                }
                .err(_) => json.null()
            }
        }
        .err(_) => json.null()
    }
}

// Lookup inside an already-loaded table. Returns "" on miss;
// json.null() tables miss immediately (zero IO).

pub func table_lookup(root: json, path: str) -> str {
    if json.type(root) != "object" {
        return ""
    }
    base := fs.basename(path)
    ext := str.to_lower(fs.extension(path))
    names := json.keys(root)
    for name in names {
        match json.get(root, name) {
            .ok(langobj) => {
                // files exact match
                if json.has(langobj, "files") {
                    match json.get(langobj, "files") {
                        .ok(arr) => {
                            n := json.len(arr)
                            for i in 0..n {
                                match json.get(arr, str(i)) {
                                    .ok(v) => {
                                        // as_str may fail for non-strings; guard via type
                                        if json.type(v) == "string" {
                                            f := json.as_str(v)
                                            if f == base {
                                                return name
                                            }
                                        }
                                        ""
                                    }
                                    .err(_) => ""
                                }
                            }
                        }
                        .err(_) => noop()
                    }
                }
                if json.has(langobj, "extensions") {
                    match json.get(langobj, "extensions") {
                        .ok(arr) => {
                            n := json.len(arr)
                            for i in 0..n {
                                match json.get(arr, str(i)) {
                                    .ok(v) => {
                                        if json.type(v) == "string" {
                                            e := str.to_lower(json.as_str(v))
                                            if e == ext {
                                                return name
                                            }
                                        }
                                        ""
                                    }
                                    .err(_) => ""
                                }
                            }
                        }
                        .err(_) => noop()
                    }
                }
            }
            .err(_) => noop()
        }
    }
    ""
}

pub func json_file_lookup(cfg: str, path: str) -> str {
    match fs.read_to_string(cfg) {
        .ok(text) => {
            match json.parse(text) {
                .ok(root) => table_lookup(root, path)
                .err(_) => ""
            }
        }
        .err(_) => ""
    }
}

pub func resolve_lang_with(root: json, path: str) -> str {
    custom := table_lookup(root, path)
    if custom != "" {
        return custom
    }
    detect_lang(path)
}

// ── Flat ext map: built ONCE per run, O(1)-ish lookup per file ──────────────
// Snapshot-safe plain data (structs of [str]), so worker tasks can capture
// it, unlike the opaque json table handle.

pub struct ExtMap {
    exts: [str],
    langs: [str],
    files: [str],
    filelangs: [str],
}

pub func build_ext_map(root: json) -> ExtMap {
    m := ExtMap{exts: [], langs: [], files: [], filelangs: []}
    if json.type(root) != "object" {
        return m
    }
    names := json.keys(root)
    for name in names {
        match json.get(root, name) {
            .ok(langobj) => {
                if json.has(langobj, "extensions") {
                    match json.get(langobj, "extensions") {
                        .ok(arr) => {
                            n := json.len(arr)
                            for i in 0..n {
                                match json.get(arr, str(i)) {
                                    .ok(v) => {
                                        if json.type(v) == "string" {
                                            m.exts = vec.push(m.exts, str.to_lower(json.as_str(v)))
                                            m.langs = vec.push(m.langs, name)
                                        }
                                        ""
                                    }
                                    .err(_) => ""
                                }
                            }
                        }
                        .err(_) => noop()
                    }
                }
                if json.has(langobj, "files") {
                    match json.get(langobj, "files") {
                        .ok(arr) => {
                            n := json.len(arr)
                            for i in 0..n {
                                match json.get(arr, str(i)) {
                                    .ok(v) => {
                                        if json.type(v) == "string" {
                                            m.files = vec.push(m.files, json.as_str(v))
                                            m.filelangs = vec.push(m.filelangs, name)
                                        }
                                        ""
                                    }
                                    .err(_) => ""
                                }
                            }
                        }
                        .err(_) => noop()
                    }
                }
            }
            .err(_) => noop()
        }
    }
    m
}

pub func resolve_fast(m: ExtMap, path: str) -> str {
    base := fs.basename(path)
    for i in 0..len(m.files) {
        if m.files[i] == base {
            return m.filelangs[i]
        }
    }
    ext := str.to_lower(fs.extension(path))
    if ext == "" {
        return detect_lang(path)
    }
    for i in 0..len(m.exts) {
        if m.exts[i] == ext {
            return m.langs[i]
        }
    }
    detect_lang(path)
}

pub func resolve_lang(path: str) -> str {
    custom := json_lookup_lang(path)
    if custom != "" {
        return custom
    }
    detect_lang(path)
}

// ── Table-driven comment rules (custom languages) ────────────────────────────
// languages.json entries carry line/block_start/block_end arrays. Builtin
// languages keep their hardcoded rules below (stable counts); these table
// lookups supply rules for languages the hardcode doesn't know (user
// customs via languages.json or config.json).

pub func json_field(o: json, key: str) -> json {
    if json.type(o) != "object" {
        return json.null()
    }
    if !json.has(o, key) {
        return json.null()
    }
    match json.get(o, key) {
        .ok(v) => v
        .err(_) => json.null()
    }
}

pub func table_str_list(root: json, lang: str, field: str) -> [str] {
    out := []
    langobj := json_field(root, lang)
    if json.type(langobj) != "object" {
        return out
    }
    arr := json_field(langobj, field)
    if json.type(arr) != "array" {
        return out
    }
    n := json.len(arr)
    for i in 0..n {
        match json.get(arr, str(i)) {
            .ok(v) => {
                if json.type(v) == "string" {
                    out = vec.push(out, json.as_str(v))
                }
            }
            .err(_) => noop()
        }
    }
    out
}

// [line markers, block starts, block ends] for lang.
//
// Precedence (stable counts first):
// - custom languages named in `customs` (config.json) use their table
//   rules wholesale — full-replace semantics, like extensions/files.
// - builtin languages keep hardcoded rules, even where the JSON table
//   disagrees (Bash `: '`, Vue `//`, ...): existing counts never shift.
// - anything else (Json/Text/Markdown, unknown): table lists, usually
//   empty, which selects the no-comment fast path.

pub func resolve_markers(table: json, lang: str, customs: [str]) -> [[str]] {
    for c in customs {
        if c == lang {
            return [table_str_list(table, lang, "line"), table_str_list(table, lang, "block_start"), table_str_list(table, lang, "block_end")]
        }
    }
    lines := line_markers(lang)
    pair := block_pair(lang)
    if len(lines) > 0 || len(pair) > 0 {
        starts := []
        ends := []
        if len(pair) == 2 {
            starts = [pair[0]]
            ends = [pair[1]]
        }
        return [lines, starts, ends]
    }
    [table_str_list(table, lang, "line"), table_str_list(table, lang, "block_start"), table_str_list(table, lang, "block_end")]
}
