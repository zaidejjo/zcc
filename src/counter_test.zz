@test
func test_is_generated_content_edges() {
    // marker past line 5 never counts
    assert(!walker.is_generated_content("a\nb\nc\nd\ne\n// generated by x\n"))
    // marker on line 5 counts
    assert(walker.is_generated_content("a\nb\nc\nd\n// generated by x\n"))
    // no trailing newline: same line count
    assert(!walker.is_generated_content("a\nb"))
    // exactly-3-line minified gate
    longline := str.repeat("b", 2001)
    assert(walker.is_generated_content("{longline}\n"))
    assert(walker.is_generated_content("a\n{longline}\n"))
    // 4 lines never minified-gated
    four := "a\nb\nc\n{longline}\n"
    assert(!walker.is_generated_content(four))
}
