// zcc tests — run with `zz test`
import counter
import languages
import walker
import report
import cache
import std.time
import std.fs
import std.env
import std.json

@test
func test_split_lines() {
    assert_eq(len(counter.split_lines("")), 0)
    assert_eq(len(counter.split_lines("a\nb\n")), 2)
    assert_eq(len(counter.split_lines("a\nb")), 2)
    assert_eq(counter.split_lines("a\nb\n")[0], "a")
}

@test
func test_big_project_ms() {
    // End-to-end: generate a 40-file synthetic project, count it like
    // run_dir does, assert totals + wall-clock budget. Guards against
    // blowups like the split_lines infinite recursion (1.5GB hang).
    base := fs.join(env.temp_dir(), "zcc_perf_proj")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
    match fs.mkdir_all(fs.join(base, "src")) {
        .ok(_) => walker.noop(),
        .err(e) => fail("mkdir: {e}"),
    }
    body := ""
    for i in 0..100 {
        body = body + "    let x = 1; // trailing\n"
    }
    chunk := "// header comment\n" + body + "/* block\nmiddle\nend */\n"
    t0 := time.now_ms()
    for i in 0..40 {
        ext := "rs"
        if i % 4 == 1 {
            ext = "py"
        } else {
            if i % 4 == 2 {
                ext = "js"
            } else {
                if i % 4 == 3 {
                    ext = "md"
                }
            }
        }
        content := chunk
        if ext == "md" {
            content = "# Title\n\n```rust\nfn f() {}\n```\n\nprose\n"
        }
        if ext == "py" {
            content = "# header comment\n" + body + "\"\"\" block\nmiddle\nend \"\"\"\n"
        }
        path := fs.join(fs.join(base, "src"), "mod" + str(i) + "." + ext)
        match fs.write(path, content) {
            .ok(_) => walker.noop(),
            .err(e) => fail("write: {e}"),
        }
    }
    files := walker.walk_files(base, [], true, false)
    table := languages.load_lang_table()
    em := languages.build_ext_map(table)
    t := report.new_table()
    counted := 0
    total_lines := 0
    for f in files {
        lang := languages.resolve_fast(em, f)
        if lang == "" {
            continue
        }
        match fs.read_to_string(f) {
            .ok(text) => {
                if walker.has_nul(text) {
                    continue
                }
                c := counter.count_content(text, lang)
                t = report.add_row(t, lang, 1, c.lines, c.code, c.comments, c.blanks)
                counted = counted + 1
                total_lines = total_lines + c.lines
            },
            .err(_) => walker.noop(),
        }
    }
    elapsed := time.now_ms() - t0
    println("perf: {counted} files, {total_lines} lines in {elapsed}ms")
    assert_eq(len(files), 40)
    assert_eq(counted, 40)
    assert(total_lines > 3000)
    assert(elapsed < 60000)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
}

@test
func test_line_comment_wins_over_block() {
    // `/*` inside a `//` comment must not open a block (old quirk).
    src := "let x = 1; // /* unclosed\nlet y = 2;\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.lines, 2)
    assert_eq(c.code, 2)
    assert_eq(c.comments, 0)
}

@test
func test_string_with_markers() {
    src := "x := \"a // b\";\ny := 1;\n"
    c := counter.count_content(src, "ZZ")
    assert_eq(c.code, 2)
    assert_eq(c.comments, 0)
}

@test
func test_nested_block() {
    src := "/* a /* b */ c */\nx := 1;\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.comments, 1)
    assert_eq(c.code, 1)
}

@test
func test_inline_block_then_code() {
    src := "/* x */\nlet y = 2; // trailing\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.comments, 1)
    assert_eq(c.code, 1)
}

@test
func test_cache_roundtrip() {
    base := fs.join(env.temp_dir(), "zcc_cache_test")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
    match fs.mkdir_all(fs.join(base, "src")) {
        .ok(_) => walker.noop(),
        .err(e) => fail("mkdir: {e}"),
    }
    path := fs.join(fs.join(base, "src"), "a.rs")
    match fs.write(path, "// hi\nfn f() {}\n") {
        .ok(_) => walker.noop(),
        .err(e) => fail("write: {e}"),
    }
    sig := cache.current_sig(path)
    assert(sig[0] != "")
    assert(sig[1] != "")
    emb := "└ Rust\x1f1\x1f2\x1f1\x1f0\x1f1"
    rows := [cache.enc_entry(path, sig[0], sig[1], "Rust", 2, 1, 1, 0, emb)]
    cache.save_cache(base, rows)
    files := cache.load_files_obj(base)
    assert(json.type(files) == "object")
    e := cache.lookup_entry(files, path)
    assert(json.type(e) == "object")
    assert_eq(cache.entry_str(e, "mtime"), sig[0])
    assert_eq(cache.entry_str(e, "size"), sig[1])
    assert_eq(cache.entry_str(e, "lang"), "Rust")
    assert_eq(cache.entry_int(e, "lines"), 2)
    assert_eq(cache.entry_int(e, "code"), 1)
    assert_eq(cache.entry_str(e, "missing"), "")
    assert_eq(cache.entry_int(e, "nope"), -1)
    embval := cache.entry_json(e, "emb")
    assert(json.type(embval) == "array")
    assert_eq(cache.emb_array_joins(embval), cache.emb_array_text(emb))
    et := cache.merge_emb_val(report.new_table(), embval)
    assert_eq(len(et.langs), 1)
    assert_eq(et.langs[0], "└ Rust")
    assert_eq(et.files[0], 1)
    assert_eq(et.lines[0], 2)
    assert_eq(et.code[0], 1)
    assert_eq(et.comments[0], 0)
    assert_eq(et.blanks[0], 1)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
}

@test
func test_cache_invalidate_on_edit() {
    base := fs.join(env.temp_dir(), "zcc_cache_inv")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
    match fs.mkdir_all(base) {
        .ok(_) => walker.noop(),
        .err(e) => fail("mkdir: {e}"),
    }
    path := fs.join(base, "b.py")
    match fs.write(path, "# one\n") {
        .ok(_) => walker.noop(),
        .err(e) => fail("write: {e}"),
    }
    sig1 := cache.current_sig(path)
    rows := [cache.enc_entry(path, sig1[0], sig1[1], "Python", 1, 0, 1, 0, "")]
    cache.save_cache(base, rows)
    match fs.write(path, "# one\n# two\nx = 1\n") {
        .ok(_) => walker.noop(),
        .err(e) => fail("rewrite: {e}"),
    }
    sig2 := cache.current_sig(path)
    files := cache.load_files_obj(base)
    e := cache.lookup_entry(files, path)
    assert(json.type(e) == "object")
    stale := cache.entry_str(e, "mtime") == sig2[0] && cache.entry_str(e, "size") == sig2[1]
    assert(!stale)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop(),
        .err(_) => walker.noop(),
    }
}

@test
func test_cache_missing_is_null() {
    files := cache.load_files_obj("/tmp/zcc_no_such_root_zzz")
    assert(json.type(files) == "null")
    e := cache.lookup_entry(files, "whatever.rs")
    assert(json.type(e) == "null")
}

@test
func test_match_pat_parity() {
    // compile_pats + match_pat must agree with match_one/is_ignored_by
    // on every (pattern, path) pair, including negations and empties.
    pats := ["target/", "src/bin/", "*.log", "build*", "**/foo", "a/**", "/abs", "plain", "!keep", "!*.tmp", "", "x"]
    rels := ["target/x", "src/bin/z", "a.log", "build9", "d/foo/f", "a/b", "abs/y", "plain", "z/plain/q", "keep", "x/keep/y", "k.tmp", "x", "other"]
    cps := walker.compile_pats(pats)
    for r in rels {
        assert_eq(walker.is_ignored_by(r, false, pats), walker.is_ignored_compiled(cps, r, fs.basename(r)))
    }
}

@test
func test_detect_rust() {
    assert_eq(languages.detect_lang("main.rs"), "Rust")
    assert_eq(languages.detect_lang("a/b.py"), "Python")
    assert_eq(languages.detect_lang("Dockerfile"), "Dockerfile")
    assert_eq(languages.detect_lang("Makefile"), "Makefile")
    assert_eq(languages.detect_lang("foo.zz"), "ZZ")
    assert_eq(languages.detect_lang("noext"), "")
}

@test
func test_count_simple_rust() {
    src := "// hi\nfn main() {\n\n    println!(\"hi\"); // trailing\n}\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.lines, 5)
    assert_eq(c.comments, 1)
    assert_eq(c.blanks, 1)
    assert_eq(c.code, 3)
}

@test
func test_count_block() {
    src := "/* start\nmiddle\nend */\nlet x = 1;\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.comments, 3)
    assert_eq(c.code, 1)
}

@test
func test_count_python() {
    src := "# hi\nx = 1\n\ny = 2 # trailing\n"
    c := counter.count_content(src, "Python")
    assert_eq(c.comments, 1)
    assert_eq(c.blanks, 1)
    assert_eq(c.code, 2)
}

@test
func test_count_json_fastpath() {
    src := "{\"a\": 1}"
    c := counter.count_content(src, "Json")
    assert_eq(c.code, 1)
    assert_eq(c.comments, 0)
}

@test
func test_count_markdown() {
    src := "# Title\n\n```rust\nfn f() {}\n```\n\nprose\n"
    c := counter.count_content(src, "Markdown")
    assert(c.lines > 0)
    assert(c.comments > 0)
}

@test
func test_ignore_match() {
    assert(walker.match_one("target/", "target/foo", false))
    assert(walker.match_one("*.log", "a/b.log", false))
    assert(!walker.match_one("*.log", "a/b.rs", false))
    assert(walker.is_ignored_by("target/x", false, ["target/"]))
    assert(!walker.is_ignored_by("src/x", false, ["target/"]))
}

@test
func test_report_json() {
    t := report.new_table()
    t = report.add_row(t, "Rust", 2, 10, 7, 2, 1)
    j := report.to_json(t)
    assert(str_contains(j, "Rust"))
    assert(str_contains(j, "total"))
}

func str_contains(s: str, sub: str) -> bool {
    // minimal contains without extra import in test scope
    i := 0
    n := len(s) - len(sub) + 1
    if n < 0 {
        return false
    }
    while i < n {
        if s[i:i + len(sub)] == sub {
            return true
        }
        i = i + 1
    }
    false
}
