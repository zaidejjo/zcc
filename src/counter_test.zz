// zcc tests — run with `zz test`
import std.env
import std.fs
import std.json
import std.process
import std.str
import std.time
import std.vec

import cache
import config
import counter
import languages
import parallel
import report
import walker

@test
func test_split_lines() {
    assert_eq(len(counter.split_lines("")), 0)
    assert_eq(len(counter.split_lines("a\nb\n")), 2)
    assert_eq(len(counter.split_lines("a\nb")), 2)
    assert_eq(counter.split_lines("a\nb\n")[0], "a")
}

@test
func test_big_project_ms() {
    // End-to-end: generate a 40-file synthetic project, count it like
    // run_dir does, assert totals + wall-clock budget. Guards against
    // blowups like the split_lines infinite recursion (1.5GB hang).
    base := fs.join(env.temp_dir(), "zcc_perf_proj")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.mkdir_all(fs.join(base, "src")) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    body := ""
    for i in 0..100 {
        body = body + "    let x = 1; // trailing\n"
    }
    chunk := "// header comment\n" + body + "/* block\nmiddle\nend */\n"
    t0 := time.now_ms()
    for i in 0..40 {
        ext := "rs"
        if i % 4 == 1 {
            ext = "py"
        } else {
            if i % 4 == 2 {
                ext = "js"
            } else {
                if i % 4 == 3 {
                    ext = "md"
                }
            }
        }
        content := chunk
        if ext == "md" {
            content = "# Title\n\n```rust\nfn f() {}\n```\n\nprose\n"
        }
        if ext == "py" {
            content = "# header comment\n" + body + "\"\"\" block\nmiddle\nend \"\"\"\n"
        }
        path := fs.join(fs.join(base, "src"), "mod" + str(i) + "." + ext)
        match fs.write(path, content) {
            .ok(_) => walker.noop()
            .err(e) => fail("write: {e}")
        }
    }
    files := walker.walk_files(base, [], true, false)
    table := languages.load_lang_table()
    em := languages.build_ext_map(table)
    t := report.new_table()
    counted := 0
    total_lines := 0
    for f in files {
        lang := languages.resolve_fast(em, f)
        if lang == "" {
            continue
        }
        match fs.read_to_string(f) {
            .ok(text) => {
                if walker.has_nul(text) {
                    continue
                }
                c := counter.count_content(text, lang)
                t = report.add_row(t, lang, 1, c.lines, c.code, c.comments, c.blanks)
                counted = counted + 1
                total_lines = total_lines + c.lines
            }
            .err(_) => walker.noop()
        }
    }
    elapsed := time.now_ms() - t0
    println("perf: {counted} files, {total_lines} lines in {elapsed}ms")
    assert_eq(len(files), 40)
    assert_eq(counted, 40)
    assert(total_lines > 3000)
    assert(elapsed < 60000)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

@test
func test_line_comment_wins_over_block() {
    // `/*` inside a `//` comment must not open a block (old quirk).
    src := "let x = 1; // /* unclosed\nlet y = 2;\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.lines, 2)
    assert_eq(c.code, 2)
    assert_eq(c.comments, 0)
}

@test
func test_string_with_markers() {
    src := "x := \"a // b\";\ny := 1;\n"
    c := counter.count_content(src, "ZZ")
    assert_eq(c.code, 2)
    assert_eq(c.comments, 0)
}

@test
func test_nested_block() {
    src := "/* a /* b */ c */\nx := 1;\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.comments, 1)
    assert_eq(c.code, 1)
}

@test
func test_inline_block_then_code() {
    src := "/* x */\nlet y = 2; // trailing\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.comments, 1)
    assert_eq(c.code, 1)
}

@test
func test_cache_roundtrip() {
    base := fs.join(env.temp_dir(), "zcc_cache_test")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.mkdir_all(fs.join(base, "src")) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    path := fs.join(fs.join(base, "src"), "a.rs")
    match fs.write(path, "// hi\nfn f() {}\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    sig := cache.current_sig(path)
    assert(sig[0] != "")
    assert(sig[1] != "")
    emb := "└ Rust\x1f1\x1f2\x1f1\x1f0\x1f1"
    rows := [cache.enc_entry(path, sig[0], sig[1], "Rust", 2, 1, 1, 0, emb)]
    cache.save_cache(base, rows)
    files := cache.load_files_obj(base)
    assert(json.type(files) == "object")
    e := cache.lookup_entry(files, path)
    assert(json.type(e) == "object")
    assert_eq(cache.entry_str(e, "mtime"), sig[0])
    assert_eq(cache.entry_str(e, "size"), sig[1])
    assert_eq(cache.entry_str(e, "lang"), "Rust")
    assert_eq(cache.entry_int(e, "lines"), 2)
    assert_eq(cache.entry_int(e, "code"), 1)
    assert_eq(cache.entry_str(e, "missing"), "")
    assert_eq(cache.entry_int(e, "nope"), -1)
    embval := cache.entry_json(e, "emb")
    assert(json.type(embval) == "array")
    assert_eq(cache.emb_array_joins(embval), cache.emb_array_text(emb))
    et := cache.merge_emb_val(report.new_table(), embval)
    assert_eq(len(et.langs), 1)
    assert_eq(et.langs[0], "└ Rust")
    assert_eq(et.files[0], 1)
    assert_eq(et.lines[0], 2)
    assert_eq(et.code[0], 1)
    assert_eq(et.comments[0], 0)
    assert_eq(et.blanks[0], 1)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

@test
func test_cache_invalidate_on_edit() {
    base := fs.join(env.temp_dir(), "zcc_cache_inv")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.mkdir_all(base) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    path := fs.join(base, "b.py")
    match fs.write(path, "# one\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    sig1 := cache.current_sig(path)
    rows := [cache.enc_entry(path, sig1[0], sig1[1], "Python", 1, 0, 1, 0, "")]
    cache.save_cache(base, rows)
    match fs.write(path, "# one\n# two\nx = 1\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("rewrite: {e}")
    }
    sig2 := cache.current_sig(path)
    files := cache.load_files_obj(base)
    e := cache.lookup_entry(files, path)
    assert(json.type(e) == "object")
    stale := cache.entry_str(e, "mtime") == sig2[0] && cache.entry_str(e, "size") == sig2[1]
    assert(!stale)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

@test
func test_cache_missing_is_null() {
    files := cache.load_files_obj("/tmp/zcc_no_such_root_zzz")
    assert(json.type(files) == "null")
    e := cache.lookup_entry(files, "whatever.rs")
    assert(json.type(e) == "null")
}

@test
func test_is_generated() {
    assert(walker.is_generated("a/bundle.min.js"))
    assert(walker.is_generated("a/app.min.css"))
    assert(walker.is_generated("dist/app.bundle.js"))
    assert(walker.is_generated("x/package-lock.json"))
    assert(walker.is_generated("Cargo.lock"))
    assert(walker.is_generated("y/yarn.lock"))
    assert(walker.is_generated("a/msg.pb.go"))
    assert(walker.is_generated("a/msg.pb.py"))
    assert(walker.is_generated("a/msg_pb2.py"))
    assert(walker.is_generated("a/foo_generated.rs"))
    assert(walker.is_generated("a/foo.generated.ts"))
    assert(walker.is_generated("a/generated/b.py"))
    assert(walker.is_generated("generated/b.py"))
    assert(!walker.is_generated("a/app.js"))
    assert(!walker.is_generated("a/main.rs"))
    assert(!walker.is_generated("a/generate.py"))
    assert(!walker.is_generated("a/Cargo.toml"))
    assert(!walker.is_generated("a/lockfile.txt"))
}

@test
func test_top_by_lines() {
    idx := report.top_by_lines([5, 20, 10], 2)
    assert_eq(len(idx), 2)
    assert_eq(idx[0], 1)
    assert_eq(idx[1], 2)
    assert_eq(len(report.top_by_lines([5, 20, 10], 0)), 0)
    assert_eq(len(report.top_by_lines([5, 20, 10], 99)), 3)
    assert_eq(len(report.top_by_lines([], 5)), 0)
    assert_eq(report.display_path("short.rs"), "short.rs")
    long := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/b.rs"
    assert_eq(report.display_path(long), "..." + long[len(long) - 41:len(long)])
}

@test
func test_files_json_shape() {
    t := report.new_table()
    t = report.add_row(t, "Rust", 1, 10, 7, 2, 1)
    j := report.to_json_full(t, report.new_table(), ["a.rs", "b.rs"], ["Rust", "Rust"], [10, 3], [7, 3], [2, 0], [1, 0], 5)
    assert(str_contains(j, "\"files\":["))
    assert(str_contains(j, "a.rs"))
    assert(str_contains(j, "\"language\":\"Rust\""))
    // both documents must be valid JSON (balanced braces regression)
    match json.parse(j) {
        .ok(_) => walker.noop()
        .err(_) => fail("to_json_full is not valid JSON")
    }
    match json.parse(report.to_json(t, report.new_table())) {
        .ok(_) => walker.noop()
        .err(_) => fail("to_json is not valid JSON")
    }
    // plain json unchanged (no files key)
    assert(!str_contains(report.to_json(t, report.new_table()), "\"files\":["))
    // embedded rows export under "embedded" with stripped lang names
    e := report.new_table()
    e = report.add_row(e, "└ BASH", 1, 20, 17, 0, 3)
    j2 := report.to_json(t, e)
    assert(str_contains(j2, "\"embedded\":{\"BASH\""))
    match json.parse(j2) {
        .ok(_) => walker.noop()
        .err(_) => fail("to_json embedded is not valid JSON")
    }
}

@test
func test_emb_base_lang() {
    assert_eq(report.emb_base_lang("└ Rust"), "Rust")
    assert_eq(report.emb_base_lang("└ BASH"), "BASH")
    assert_eq(report.emb_base_lang("Rust"), "Rust")
    assert_eq(report.emb_base_lang(""), "")
}

@test
func test_init_config() {
    base := fs.join(env.temp_dir(), "zcc_init_test")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    dir := fs.join(base, "zcc")
    m1 := config.init_config(dir, false)
    assert(str_contains(m1, "wrote"))
    assert(fs.exists(fs.join(dir, "config.json")))
    m2 := config.init_config(dir, false)
    assert(str_contains(m2, "already exists"))
    m3 := config.init_config(dir, true)
    assert(str_contains(m3, "wrote"))
    // written default parses and equals theme defaults
    match fs.read_to_string(fs.join(dir, "config.json")) {
        .ok(text) => {
            match json.parse(text) {
                .ok(cfg) => {
                    th := config.build_theme(cfg)
                    assert(th.color)
                    assert_eq(th.header, "cyan")
                    assert_eq(report.theme_lang_color(th, "ZZ"), "#1e8ffb")
                    assert_eq(report.theme_lang_color(th, "Rust"), "#ff5500")
                    assert_eq(report.theme_lang_color(th, "Zig"), "")
                    langs := config.custom_names(cfg)
                    assert_eq(len(langs), 0)
                }
                .err(_) => fail("written config must parse")
            }
        }
        .err(_) => fail("written config must read")
    }
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

@test
func test_theme_from_config() {
    th := config.build_theme(json.null())
    assert(th.color)
    assert_eq(th.header, "cyan")
    assert_eq(th.language, "green")
    assert_eq(report.theme_lang_color(th, "Rust"), "")
    match json.parse("{{\"display\": {{\"color\": false, \"header\": \"#ff0000\", \"language\": \"255,0,0\", \"total\": \"red\", \"languages\": {{\"Rust\": \"bright_blue\", \"Go\": \"notacolor\"}}}}}}") {
        .ok(cfg) => {
            t2 := config.build_theme(cfg)
            assert(!t2.color)
            assert_eq(t2.header, "#ff0000")
            assert_eq(t2.language, "255,0,0")
            assert_eq(t2.total, "red")
            assert_eq(report.theme_lang_color(t2, "Rust"), "bright_blue")
            assert_eq(report.theme_lang_color(t2, "Zig"), "")
            // apply_color honors the off switch + specs
            assert_eq(report.apply_color(t2, "red", "x"), "x")
            assert_eq(report.apply_color(th, "red", "x") == "x", false)
            assert_eq(report.apply_color(th, "#ff0000", "x") == "x", false)
            assert_eq(report.apply_color(th, "255,0,0", "x") == "x", false)
            assert_eq(report.apply_color(th, "notacolor", "x"), "x")
            assert_eq(report.apply_color(th, "", "x"), "x")
            assert(report.is_plain_lang(th, "Markdown"))
            assert(!report.is_plain_lang(th, "Rust"))
        }
        .err(_) => fail("config json must parse")
    }
}

@test
func test_custom_lang_end_to_end() {
    match json.parse("{{\"languages\": {{\"MyLang\": {{\"extensions\": [\"myl\"], \"files\": [\"Myfile\"], \"line\": [\"#\"], \"block_start\": [\"/*\"], \"block_end\": [\"*/\"]}}}}}}") {
        .ok(cfg) => {
            table := config.lang_table_with(cfg)
            em := languages.build_ext_map(table)
            assert_eq(languages.resolve_fast(em, "a/myl.myl"), "MyLang")
            assert_eq(languages.resolve_fast(em, "Myfile"), "MyLang")
            rules := languages.resolve_markers(table, "MyLang", ["MyLang"])
            assert_eq(rules[0], ["#"])
            assert_eq(rules[1], ["/*"])
            assert_eq(rules[2], ["*/"])
            c := counter.count_content_with("# hi\nx = 1\n/* b\nq */\n", "MyLang", rules[0], rules[1][0], rules[2][0])
            assert_eq(c.lines, 4)
            assert_eq(c.comments, 3)
            assert_eq(c.code, 1)
            // builtin rules untouched by customs
            rr := languages.resolve_markers(table, "Rust", ["MyLang"])
            assert_eq(rr[0], ["//"])
        }
        .err(_) => fail("custom lang json must parse")
    }
}

@test
func test_parallel_chunk_matches_serial() {
    // count_files must equal the serial counter on every file kind
    // (code, markdown fences, NUL binary, missing file) and honor
    // sub-ranges. Guards the phase-2 fan-out without spawning tasks.
    base := fs.join(env.temp_dir(), "zcc_par_test")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.mkdir_all(base) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    rsrc := "// hi\nfn f() {}\n"
    psrc := "# c\nx = 1\n"
    msrc := "# T\n\n```rust\nfn f() {}\n```\n"
    bsrc := "ab\x00cd"
    rp := fs.join(base, "a.rs")
    pp := fs.join(base, "b.py")
    mp := fs.join(base, "c.md")
    bp := fs.join(base, "d.bin")
    match fs.write(rp, rsrc) {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    match fs.write(pp, psrc) {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    match fs.write(mp, msrc) {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    match fs.write(bp, bsrc) {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    paths := [rp, pp, mp, bp, fs.join(base, "nope.rs")]
    langs := ["Rust", "Python", "Markdown", "Rust", "Rust"]
    shows := ["Rust", "Python", "Markdown", "Rust", "Rust"]
    out := run_chunk(paths, langs, shows, 0, len(paths))
    assert_eq(out.oks, [1, 1, 1, 0, 0])
    bodies := [rsrc, psrc, msrc]
    for k in 0..3 {
        c := serial_count(bodies[k], langs[k])
        assert_eq(out.lines[k], c.lines)
        assert_eq(out.code[k], c.code)
        assert_eq(out.comments[k], c.comments)
        assert_eq(out.blanks[k], c.blanks)
    }
    assert_eq(out.fencs[2], parallel.fence_enc(msrc))
    assert_eq(out.fencs[0], "")
    sub := run_chunk(paths, langs, shows, 1, 3)
    assert_eq(sub.lines[0], out.lines[1])
    assert_eq(sub.lines[1], out.lines[2])
    assert_eq(sub.oks, [1, 1])
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

// Build worker inputs exactly like run_dir phase 1, then count.

func run_chunk(paths: [str], langs: [str], shows: [str], start: int, end: int) -> parallel.ChunkOut {
    mjoined := []
    bstarts := []
    bends := []
    for i in 0..len(paths) {
        lang := langs[i]
        rules := languages.resolve_markers(json.null(), lang, [])
        mjoined = vec.push(mjoined, str.join(rules[0], "\x01"))
        b0 := ""
        b1 := ""
        if len(rules[1]) > 0 {
            b0 = rules[1][0]
        }
        if len(rules[2]) > 0 {
            b1 = rules[2][0]
        }
        bstarts = vec.push(bstarts, b0)
        bends = vec.push(bends, b1)
    }
    parallel.count_files(paths, langs, shows, mjoined, bstarts, bends, start, end)
}

func serial_count(body: str, lang: str) -> counter.Counts {
    rules := languages.resolve_markers(json.null(), lang, [])
    b0 := ""
    b1 := ""
    if len(rules[1]) > 0 {
        b0 = rules[1][0]
    }
    if len(rules[2]) > 0 {
        b1 = rules[2][0]
    }
    counter.count_content_with(body, lang, rules[0], b0, b1)
}

@test
func test_count_with_matches_plain() {
    // count_content_with with hardcoded-equivalent rules == count_content.
    for lang in ["Rust", "Python", "Bash", "Json", "Text"] {
        src := "// c\ncode();\n# py\n"
        a := counter.count_content(src, lang)
        m := languages.resolve_markers(json.null(), lang, [])
        b0 := ""
        b1 := ""
        if len(m[1]) > 0 {
            b0 = m[1][0]
        }
        if len(m[2]) > 0 {
            b1 = m[2][0]
        }
        b := counter.count_content_with(src, lang, m[0], b0, b1)
        assert_eq(a.lines, b.lines)
        assert_eq(a.code, b.code)
        assert_eq(a.comments, b.comments)
        assert_eq(a.blanks, b.blanks)
    }
}

@test
func test_match_pat_parity() {
    // compile_pats + match_pat must agree with match_one/is_ignored_by
    // on every (pattern, path) pair, including negations and empties.
    pats := ["target/", "src/bin/", "*.log", "build*", "**/foo", "a/**", "/abs", "plain", "!keep", "!*.tmp", "", "x"]
    rels := ["target/x", "src/bin/z", "a.log", "build9", "d/foo/f", "a/b", "abs/y", "plain", "z/plain/q", "keep", "x/keep/y", "k.tmp", "x", "other"]
    cps := walker.compile_pats(pats)
    for r in rels {
        assert_eq(walker.is_ignored_by(r, false, pats), walker.is_ignored_compiled(cps, r, fs.basename(r)))
    }
}

@test
func test_detect_rust() {
    assert_eq(languages.detect_lang("main.rs"), "Rust")
    assert_eq(languages.detect_lang("a/b.py"), "Python")
    assert_eq(languages.detect_lang("Dockerfile"), "Dockerfile")
    assert_eq(languages.detect_lang("Makefile"), "Makefile")
    assert_eq(languages.detect_lang("foo.zz"), "ZZ")
    assert_eq(languages.detect_lang("noext"), "")
}

@test
func test_count_simple_rust() {
    src := "// hi\nfn main() {\n\n    println!(\"hi\"); // trailing\n}\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.lines, 5)
    assert_eq(c.comments, 1)
    assert_eq(c.blanks, 1)
    assert_eq(c.code, 3)
}

@test
func test_count_block() {
    src := "/* start\nmiddle\nend */\nlet x = 1;\n"
    c := counter.count_content(src, "Rust")
    assert_eq(c.comments, 3)
    assert_eq(c.code, 1)
}

@test
func test_count_python() {
    src := "# hi\nx = 1\n\ny = 2 # trailing\n"
    c := counter.count_content(src, "Python")
    assert_eq(c.comments, 1)
    assert_eq(c.blanks, 1)
    assert_eq(c.code, 2)
}

@test
func test_count_json_fastpath() {
    src := "{\"a\": 1}"
    c := counter.count_content(src, "Json")
    assert_eq(c.code, 1)
    assert_eq(c.comments, 0)
}

@test
func test_count_markdown() {
    src := "# Title\n\n```rust\nfn f() {}\n```\n\nprose\n"
    c := counter.count_content(src, "Markdown")
    assert(c.lines > 0)
    assert(c.comments > 0)
}

@test
func test_ignore_match() {
    assert(walker.match_one("target/", "target/foo", false))
    assert(walker.match_one("*.log", "a/b.log", false))
    assert(!walker.match_one("*.log", "a/b.rs", false))
    assert(walker.is_ignored_by("target/x", false, ["target/"]))
    assert(!walker.is_ignored_by("src/x", false, ["target/"]))
}

@test
func test_report_json() {
    t := report.new_table()
    t = report.add_row(t, "Rust", 2, 10, 7, 2, 1)
    j := report.to_json(t, report.new_table())
    assert(str_contains(j, "Rust"))
    assert(str_contains(j, "total"))
}

@test
func test_walk_par_matches_serial() {
    // Parallel walk must list exactly what the serial walk lists,
    // in the same order (nested dirs, hidden skips, ignore rules).
    base := fs.join(env.temp_dir(), "zcc_walk_par")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.mkdir_all(fs.join(fs.join(base, "sub1"), "nested")) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    match fs.mkdir_all(fs.join(base, "sub2")) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    match fs.mkdir_all(fs.join(base, "target")) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    match fs.mkdir_all(fs.join(base, ".hidden")) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    files := ["f1.rs", "sub1/f2.py", "sub1/nested/f3.js", "sub2/f4.md", ".hidden/f5.rs", "target/f6.rs", "x.log"]
    for f in files {
        match fs.write(fs.join(base, f), "x\n") {
            .ok(_) => walker.noop()
            .err(e) => fail("write: {e}")
        }
    }
    match fs.write(fs.join(base, ".gitignore"), "*.log\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    pats := walker.load_patterns(base)
    serial := walker.walk_files(base, pats, true, false)
    assert_eq(len(serial), 4)
    par := walker.walk_files_par(base, pats, true, false, 4)
    assert_eq(par, serial)
    par1 := walker.walk_files_par(base, pats, true, false, 1)
    assert_eq(par1, serial)
    parmany := walker.walk_files_par(base, pats, true, false, 64)
    assert_eq(parmany, serial)
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

@test
func test_tokei_differential() {
    // Curated fixtures where zcc and tokei semantics agree exactly.
    // Skips (passes) when tokei is not installed.
    have_tokei := false
    match process.run("tokei", ["--version"]) {
        .ok(_) => have_tokei = true
        .err(_) => walker.noop()
    }
    if !have_tokei {
        return
    }
    base := fs.join(env.temp_dir(), "zcc_tokei_diff")
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
    match fs.mkdir_all(base) {
        .ok(_) => walker.noop()
        .err(e) => fail("mkdir: {e}")
    }
    match fs.write(fs.join(base, "a.rs"), "// hi\nfn f() {}\n\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    match fs.write(fs.join(base, "b.py"), "# c\nx = 1\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    match fs.write(fs.join(base, "c.c"), "/* b */\nint x;\n") {
        .ok(_) => walker.noop()
        .err(e) => fail("write: {e}")
    }
    // zcc side
    zlines := 0
    zcode := 0
    zcomments := 0
    zblanks := 0
    for f in ["a.rs", "b.py", "c.c"] {
        lang := languages.detect_lang(f)
        match fs.read_to_string(fs.join(base, f)) {
            .ok(text) => {
                c := counter.count_content(text, lang)
                zlines = zlines + c.lines
                zcode = zcode + c.code
                zcomments = zcomments + c.comments
                zblanks = zblanks + c.blanks
            }
            .err(_) => fail("read: {f}")
        }
    }
    // tokei side
    match process.run("tokei", ["--output", "json", base]) {
        .ok(out) => {
            if out[0] != 0 {
                fail("tokei failed")
            }
            match json.parse(out[1]) {
                .ok(root) => {
                    match json.get(root, "Total") {
                        .ok(total) => {
                            match json.get(total, "code") {
                                .ok(v) => assert_eq(json.as_int(v), zcode)
                                .err(_) => fail("no tokei code")
                            }
                            match json.get(total, "comments") {
                                .ok(v) => assert_eq(json.as_int(v), zcomments)
                                .err(_) => fail("no tokei comments")
                            }
                            match json.get(total, "blanks") {
                                .ok(v) => assert_eq(json.as_int(v), zblanks)
                                .err(_) => fail("no tokei blanks")
                            }
                        }
                        .err(_) => fail("no tokei Total")
                    }
                }
                .err(_) => fail("tokei json must parse")
            }
        }
        .err(_) => fail("tokei must run")
    }
    match fs.remove_dir_all(base) {
        .ok(_) => walker.noop()
        .err(_) => walker.noop()
    }
}

func str_contains(s: str, sub: str) -> bool {
    // minimal contains without extra import in test scope
    i := 0
    n := len(s) - len(sub) + 1
    if n < 0 {
        return false
    }
    while i < n {
        if s[i:i + len(sub)] == sub {
            return true
        }
        i = i + 1
    }
    false
}

@test
func test_astro_basic() {
    src := "---\ntitle: hi\n---\n<!-- comment -->\n<h1>{{x}}</h1>\n<style>\n.a { color: red; }\n</style>\n<script>\nlet y = 1; // init\n</script>\n<p>done</p>\n"
    c := counter.count_content(src, "Astro")
    assert_eq(c.lines, 12)
    assert_eq(c.code, 9)
    assert_eq(c.comments, 3)
    assert_eq(c.blanks, 0)
}

@test
func test_astro_embeds() {
    src := "---\ntitle: hi\n---\n<p>x</p>\n<style>\n.a { color: red; }\n</style>\n"
    e := counter.astro_embeds(src)
    assert_eq(len(e), 2)
    langs := str.split(e[0], "\x01")
    assert_eq(len(langs), 2)
    assert_eq(langs[0], "Yaml")
    assert_eq(langs[1], "Css")
    enc := parallel.astro_enc(src)
    t := report.new_table()
    t = cache.merge_emb_enc(t, enc)
    assert_eq(report.totals(t)[0], 2)
}

@test
func test_sort_keys() {
    t := report.new_table()
    t = report.add_row(t, "A", 1, 30, 10, 5, 1)
    t = report.add_row(t, "B", 5, 10, 20, 1, 1)
    s := report.sort_table(t, "code", false)
    assert_eq(s.langs[0], "B")
    s = report.sort_table(t, "files", false)
    assert_eq(s.langs[0], "B")
    s = report.sort_table(t, "lines", true)
    assert_eq(s.langs[0], "B")
    assert_eq(report.display_name("Css"), "CSS")
    assert_eq(report.display_name("Json"), "JSON")
    assert_eq(report.display_name("Rust"), "Rust")
}
