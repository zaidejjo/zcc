// zcc/src/report.zz — tokei-style table + JSON output.
import std.colors
import std.str
import std.vec

pub func noop() {
    
    
}

// Local cell padding. NOTE: stdlib pad_right miscompiles in large AOT
// programs (`needed` inferred bool → no padding; toolchain bug), so pad
// here via native repeat with pinned int locals (no inferable temps).

pub func pad_r(s: str, w: int) -> str {
    n:int = len(s)
    if n >= w {
        return s
    }
    s + str.repeat(" ", w - n)
}

pub func pad_l(s: str, w: int) -> str {
    n:int = len(s)
    if n >= w {
        return s
    }
    str.repeat(" ", w - n) + s
}

// Display theme: hues are specs resolved by apply_color — a color name
// (green, cyan, bright_red, ...), "#rrggbb" / "#rgb" hex, or "r,g,b".
// names/specs are per-language overrides ("Rust" -> "#ff5500").

pub struct Theme {
    color: bool,
    header: str,
    language: str,
    total: str,
    names: [str],
    specs: [str],
    style: str,
}

pub func default_theme() -> Theme {
    Theme{color: true, header: "cyan", language: "green", total: "cyan", names: [], specs: [], style: "rounded"}
}

// Cross-module constructor (struct literals are same-module only).
// NOTE: branch on the flag with literal inits — initializing a bool
// field directly from a bool parameter miscompiles in AOT
// (`zz_bool(boxed)`; toolchain bug), so keep params out of struct inits.

pub func make_theme(color: bool, header: str, language: str, total: str, names: [str], specs: [str], style: str) -> Theme {
    if color {
        return Theme{color: true, header: header, language: language, total: total, names: names, specs: specs, style: style}
    }
    Theme{color: false, header: header, language: language, total: total, names: names, specs: specs, style: style}
}

pub func theme_lang_color(th: Theme, lang: str) -> str {
    for i in 0..len(th.names) {
        if th.names[i] == lang {
            return th.specs[i]
        }
    }
    ""
}

pub func apply_color(th: Theme, spec: str, s: str) -> str {
    if !th.color {
        return s
    }
    if spec == "" {
        return s
    }
    if str.starts_with(spec, "#") {
        return colors.hex(s, spec)
    }
    if str.contains(spec, ",") {
        parts := str.split(spec, ",")
        if len(parts) == 3 {
            r := int(str.trim(parts[0])) ?? -1
            g := int(str.trim(parts[1])) ?? -1
            b := int(str.trim(parts[2])) ?? -1
            if r >= 0 && g >= 0 && b >= 0 {
                return colors.rgb(s, r, g, b)
            }
        }
        return s
    }
    if spec == "black" {
        return colors.black(s)
    }
    if spec == "red" {
        return colors.red(s)
    }
    if spec == "green" {
        return colors.green(s)
    }
    if spec == "yellow" {
        return colors.yellow(s)
    }
    if spec == "blue" {
        return colors.blue(s)
    }
    if spec == "magenta" {
        return colors.magenta(s)
    }
    if spec == "cyan" {
        return colors.cyan(s)
    }
    if spec == "white" {
        return colors.white(s)
    }
    if spec == "bright_black" {
        return colors.bright_black(s)
    }
    if spec == "bright_red" {
        return colors.bright_red(s)
    }
    if spec == "bright_green" {
        return colors.bright_green(s)
    }
    if spec == "bright_yellow" {
        return colors.bright_yellow(s)
    }
    if spec == "bright_blue" {
        return colors.bright_blue(s)
    }
    if spec == "bright_magenta" {
        return colors.bright_magenta(s)
    }
    if spec == "bright_cyan" {
        return colors.bright_cyan(s)
    }
    if spec == "bright_white" {
        return colors.bright_white(s)
    }
    s
}

// Language cell: per-language override wins; Markdown/Text stay plain
// unless explicitly overridden; otherwise the default language hue.

pub func is_plain_lang(th: Theme, lang: str) -> bool {
    if theme_lang_color(th, lang) != "" {
        return false
    }
    lang == "Markdown" || lang == "Text"
}

pub func maybe_bold(th: Theme, s: str) -> str {
    if !th.color {
        return s
    }
    colors.bold(s)
}

pub func lang_cell(th: Theme, lang: str, cell: str) -> str {
    ov := theme_lang_color(th, lang)
    if ov != "" {
        return maybe_bold(th, apply_color(th, ov, cell))
    }
    if lang == "Markdown" || lang == "Text" {
        return cell
    }
    maybe_bold(th, apply_color(th, th.language, cell))
}

// Aggregate rows: parallel arrays.

pub struct Table {
    langs: [str],
    files: [int],
    lines: [int],
    code: [int],
    comments: [int],
    blanks: [int],
}

pub func new_table() -> Table {
    Table{langs: [], files: [], lines: [], code: [], comments: [], blanks: []}
}

pub func find_lang(t: Table, lang: str) -> int {
    i := 0
    for l in t.langs {
        if l == lang {
            return i
        }
        i = i + 1
    }
    -1
}

pub func add_row(t: Table, lang: str, files: int, lines: int, code: int, comments: int, blanks: int) -> Table {
    idx := find_lang(t, lang)
    if idx >= 0 {
        t.files[idx] = t.files[idx] + files
        t.lines[idx] = t.lines[idx] + lines
        t.code[idx] = t.code[idx] + code
        t.comments[idx] = t.comments[idx] + comments
        t.blanks[idx] = t.blanks[idx] + blanks
        return t
    }
    t.langs = vec.push(t.langs, lang)
    t.files = vec.push(t.files, files)
    t.lines = vec.push(t.lines, lines)
    t.code = vec.push(t.code, code)
    t.comments = vec.push(t.comments, comments)
    t.blanks = vec.push(t.blanks, blanks)
    t
}

// Display names: canonical keys stay machine-readable (Css, Json)
// while the table shows the conventional acronym casing (CSS, JSON).

pub func display_name(lang: str) -> str {
    for pair in display_map() {
        if pair[0] == lang {
            return pair[1]
        }
    }
    lang
}

// Display names: canonical keys stay machine-readable (Css, Json)
// while the table shows conventional spellings (CSS, C#, ...).
// Data-driven pair list, same linear-scan convention as
// languages.is_one_of.

func display_map() -> [[str]] {
    [["Css", "CSS"], ["Svg", "SVG"], ["Json", "JSON"], ["Toml", "TOML"], ["Html", "HTML"], ["Xml", "XML"], ["Yaml", "YAML"], ["Sql", "SQL"], ["CSharp", "C#"], ["Cpp", "C++"], ["CppHeader", "C++ Header"], ["CHeader", "C Header"], ["FSharp", "F#"], ["Jsx", "JSX"], ["Tsx", "TSX"], ["Mdx", "MDX"], ["VimScript", "Vim Script"], ["ObjectiveC", "Objective-C"], ["ObjectiveCpp", "Objective-C++"], ["Scss", "SCSS"], ["Protobuf", "Protocol Buffers"]]
}

// Sort by any column, descending unless rev. Bubble, n small.

pub func sort_table(t: Table, key: str, rev: bool) -> Table {
    n := len(t.langs)
    i := 0
    while i < n {
        j := i + 1
        while j < n {
            a := col_val(t, key, i)
            b := col_val(t, key, j)
            swap := false
            if rev {
                if b < a {
                    swap = true
                }
            } else {
                if b > a {
                    swap = true
                }
            }
            if swap {
                tmp := t.langs[i]
                t.langs[i] = t.langs[j]
                t.langs[j] = tmp
                ti := t.files[i]
                t.files[i] = t.files[j]
                t.files[j] = ti
                ti = t.lines[i]
                t.lines[i] = t.lines[j]
                t.lines[j] = ti
                ti = t.code[i]
                t.code[i] = t.code[j]
                t.code[j] = ti
                ti = t.comments[i]
                t.comments[i] = t.comments[j]
                t.comments[j] = ti
                ti = t.blanks[i]
                t.blanks[i] = t.blanks[j]
                t.blanks[j] = ti
            }
            j = j + 1
        }
        i = i + 1
    }
    t
}

func col_val(t: Table, key: str, i: int) -> int {
    if key == "files" {
        return t.files[i]
    }
    if key == "lines" {
        return t.lines[i]
    }
    if key == "comments" {
        return t.comments[i]
    }
    if key == "blanks" {
        return t.blanks[i]
    }
    t.code[i]
}

pub func totals(t: Table) -> [int] {
    tf := 0
    tl := 0
    tc := 0
    tm := 0
    tb := 0
    for x in t.files {
        tf = tf + x
    }
    for x in t.lines {
        tl = tl + x
    }
    for x in t.code {
        tc = tc + x
    }
    for x in t.comments {
        tm = tm + x
    }
    for x in t.blanks {
        tb = tb + x
    }
    [tf, tl, tc, tm, tb]
}

pub func print_table(t: Table, th: Theme, boxed: bool) {
    print_table_full(t, new_table(), th, "code", false, boxed)
}

// Language cell text (colored display name, never padded — the table
// package measures visible widths, ANSI-safe).

func lang_text(th: Theme, lang: str) -> str {
    show := display_name(lang)
    if is_plain_lang(th, lang) {
        return show
    }
    lang_cell(th, lang, show)
}

func head_cells(th: Theme, headers: [str]) -> [str] {
    out := []
    for h in headers {
        out = vec.push(out, maybe_bold(th, apply_color(th, th.header, h)))
    }
    out
}

func num_cells(vals: [int]) -> [str] {
    out := []
    for v in vals {
        out = vec.push(out, str(v))
    }
    out
}

// Full table: main languages, embedded-code section, Total closes the
// table last. The embedded section sits ABOVE Total as its own bordered
// block (inline nesting would break column alignment, so fence code
// never renders in-tree).

// Internal boxed renderer (replaces the vendored table package):
// framed (rounded/sharp/heavy/double/ascii), markdown, minimal.
// ANSI-safe widths, titles, footers. No paging/truncation/caps: our
// tables are small and pre-sanitized. Padding fixed 1, frame always
// on. Column 0 left-aligned, the rest right (files tables: first two
// left, the rest right — callers pass aligns explicitly).

func box_style_name(s: str) -> str {
    if s == "sharp" {
        return "sharp"
    }
    if s == "heavy" {
        return "heavy"
    }
    if s == "double" {
        return "double"
    }
    if s == "markdown" {
        return "markdown"
    }
    if s == "minimal" {
        return "minimal"
    }
    if s == "ascii" {
        return "ascii"
    }
    "rounded"
}

func box_glyphs(st: str) -> [str] {
    if st == "sharp" {
        return ["┌", "┐", "└", "┘", "─", "│", "├", "┤", "┬", "┴", "┼"]
    }
    if st == "heavy" {
        return ["┏", "┓", "┗", "┛", "━", "┃", "┣", "┫", "┳", "┻", "╋"]
    }
    if st == "double" {
        return ["╔", "╗", "╚", "╝", "═", "║", "╠", "╣", "╦", "╩", "╬"]
    }
    if st == "ascii" {
        return ["+", "+", "+", "+", "-", "|", "+", "+", "+", "+", "+"]
    }
    ["╭", "╮", "╰", "╯", "─", "│", "├", "┤", "┬", "┴", "┼"]
}

func box_visible_len(s: str) -> int {
    chars := str.split(s, "")
    n:int = 0
    esc:int = 0
    i:int = 0
    total := len(chars)
    c := ""
    while i < total {
        c = chars[i]
        if c == "\e" {
            esc = 1
        } else {
            if esc == 1 {
                if c == "m" {
                    esc = 0
                }
            } else {
                if c != "" {
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    n
}

func box_sanitize(s: str) -> str {
    r := str.replace(s, "\r", "")
    r = str.replace(r, "\n", " ")
    r = str.replace(r, "\t", " ")
    r
}

func box_pad_cell(s: str, width: int, mode: str) -> str {
    v := box_visible_len(s)
    gap := width - v
    if gap <= 0 {
        return s
    }
    if mode == "right" {
        return str.repeat(" ", gap) + s
    }
    if mode == "center" {
        left := gap / 2
        right := gap - left
        return str.repeat(" ", left) + s + str.repeat(" ", right)
    }
    s + str.repeat(" ", gap)
}

func box_align_at(aligns: [str], i: int) -> str {
    if i >= 0 && i < len(aligns) {
        if aligns[i] == "right" {
            return "right"
        }
        if aligns[i] == "center" {
            return "center"
        }
    }
    "left"
}

func box_widths(headers: [str], rows: [[str]], footer: [str]) -> [int] {
    ncols:int = len(headers)
    if len(rows) > 0 && len(rows[0]) > ncols {
        ncols = len(rows[0])
    }
    for r in rows {
        if len(r) > ncols {
            ncols = len(r)
        }
    }
    if len(footer) > ncols {
        ncols = len(footer)
    }
    widths:[int] = []
    i:int = 0
    while i < ncols {
        widths = vec.push(widths, 0)
        i = i + 1
    }
    i = 0
    while i < ncols {
        cell := ""
        if i < len(headers) {
            cell = box_sanitize(headers[i])
        }
        w := box_visible_len(cell)
        if w > widths[i] {
            widths[i] = w
        }
        i = i + 1
    }
    for r in rows {
        i = 0
        while i < ncols {
            cell := ""
            if i < len(r) {
                cell = box_sanitize(r[i])
            }
            w := box_visible_len(cell)
            if w > widths[i] {
                widths[i] = w
            }
            i = i + 1
        }
    }
    i = 0
    while i < ncols {
        cell := ""
        if i < len(footer) {
            cell = box_sanitize(footer[i])
        }
        w := box_visible_len(cell)
        if w > widths[i] {
            widths[i] = w
        }
        i = i + 1
    }
    widths
}

func box_inner_width(widths: [int]) -> int {
    total:int = 0
    i:int = 0
    n := len(widths)
    while i < n {
        total = total + widths[i] + 2
        i = i + 1
    }
    if n > 1 {
        total = total + (n - 1)
    }
    total
}

func box_rule(g: [str], pos: int, widths: [int]) -> str {
    left := ""
    mid := ""
    right := ""
    if pos == 0 {
        left = g[0]
        right = g[1]
        mid = g[8]
    } else {
        if pos == 2 {
            left = g[2]
            right = g[3]
            mid = g[9]
        } else {
            left = g[6]
            right = g[7]
            mid = g[10]
        }
    }
    fill := g[4]
    out := left
    i:int = 0
    n := len(widths)
    while i < n {
        seg := widths[i] + 2
        out = out + str.repeat(fill, seg)
        if i + 1 < n {
            out = out + mid
        }
        i = i + 1
    }
    out + right
}

func box_data_line(cells: [str], widths: [int], v: str, aligns: [str]) -> str {
    out := v
    i:int = 0
    n := len(widths)
    while i < n {
        raw := ""
        if i < len(cells) {
            raw = box_sanitize(cells[i])
        }
        mode := box_align_at(aligns, i)
        out = out + " " + box_pad_cell(raw, widths[i], mode) + " "
        if i + 1 < n {
            out = out + v
        }
        i = i + 1
    }
    out + v
}

pub func box_lang_aligns(ncols: int) -> [str] {
    box_num_aligns(ncols, false)
}

pub func box_file_aligns(ncols: int) -> [str] {
    box_num_aligns(ncols, true)
}

pub func box_render(headers: [str], rows: [[str]], footer: [str], title: str, style: str, aligns: [str]) -> str {
    st := box_style_name(style)
    if st == "markdown" {
        return box_render_markdown(headers, rows, footer, title, aligns)
    }
    if st == "minimal" {
        return box_render_minimal(headers, rows, footer, title, aligns)
    }
    box_render_framed(headers, rows, footer, title, st, aligns)
}

func box_num_aligns(ncols: int, first_left_two: bool) -> [str] {
    out:[str] = []
    i:int = 0
    while i < ncols {
        if i == 0 {
            out = vec.push(out, "left")
        } else {
            if i == 1 && first_left_two {
                out = vec.push(out, "left")
            } else {
                out = vec.push(out, "right")
            }
        }
        i = i + 1
    }
    out
}

func box_render_framed(headers: [str], rows: [[str]], footer: [str], title: str, st: str, aligns: [str]) -> str {
    widths := box_widths(headers, rows, footer)
    ncols := len(widths)
    if ncols == 0 {
        return ""
    }
    g := box_glyphs(st)
    v := g[5]
    lines:[str] = []
    if len(title) > 0 {
        w := box_inner_width(widths) + 2
        tw := box_visible_len(title)
        line := box_sanitize(title)
        if tw < w {
            gap := w - tw
            left := gap / 2
            right := gap - left
            line = str.repeat(" ", left) + line + str.repeat(" ", right)
        }
        lines = vec.push(lines, line)
    }
    lines = vec.push(lines, box_rule(g, 0, widths))
    lines = vec.push(lines, box_data_line(headers, widths, v, aligns))
    has_body:bool = len(rows) > 0
    has_foot:bool = len(footer) > 0
    if has_body || has_foot {
        lines = vec.push(lines, box_rule(g, 1, widths))
    }
    for r in rows {
        lines = vec.push(lines, box_data_line(r, widths, v, aligns))
    }
    if has_foot {
        if has_body {
            lines = vec.push(lines, box_rule(g, 1, widths))
        }
        lines = vec.push(lines, box_data_line(footer, widths, v, aligns))
    }
    lines = vec.push(lines, box_rule(g, 2, widths))
    vec.join(lines, "\n") + "\n"
}

func box_md_line(cells: [str], outer: int) -> str {
    body := vec.join(cells, " | ")
    if outer == 1 {
        return "| " + body + " |"
    }
    body
}

func box_render_markdown(headers: [str], rows: [[str]], footer: [str], title: str, aligns: [str]) -> str {
    widths := box_widths(headers, rows, footer)
    ncols := len(widths)
    if ncols == 0 {
        return ""
    }
    i:int = 0
    while i < ncols {
        if widths[i] < 3 {
            widths[i] = 3
        }
        i = i + 1
    }
    lines:[str] = []
    if len(title) > 0 {
        lines = vec.push(lines, "# " + box_sanitize(title))
    }
    hp:[str] = []
    mp:[str] = []
    i = 0
    while i < ncols {
        raw := ""
        if i < len(headers) {
            raw = box_sanitize(headers[i])
        }
        mode := box_align_at(aligns, i)
        hp = vec.push(hp, box_pad_cell(raw, widths[i], mode))
        mark := str.repeat("-", widths[i])
        if mode == "right" {
            mark = str.repeat("-", widths[i] - 1) + ":"
        }
        mp = vec.push(mp, mark)
        i = i + 1
    }
    lines = vec.push(lines, box_md_line(hp, 1))
    lines = vec.push(lines, box_md_line(mp, 1))
    for r in rows {
        rp:[str] = []
        i = 0
        while i < ncols {
            raw := ""
            if i < len(r) {
                raw = box_sanitize(r[i])
            }
            mode := box_align_at(aligns, i)
            rp = vec.push(rp, box_pad_cell(raw, widths[i], mode))
            i = i + 1
        }
        lines = vec.push(lines, box_md_line(rp, 1))
    }
    if len(footer) > 0 {
        rp:[str] = []
        i = 0
        while i < ncols {
            raw := ""
            if i < len(footer) {
                raw = box_sanitize(footer[i])
            }
            rp = vec.push(rp, box_pad_cell(raw, widths[i], box_align_at(aligns, i)))
            i = i + 1
        }
        lines = vec.push(lines, box_md_line(rp, 1))
    }
    vec.join(lines, "\n") + "\n"
}

func box_render_minimal(headers: [str], rows: [[str]], footer: [str], title: str, aligns: [str]) -> str {
    widths := box_widths(headers, rows, footer)
    ncols := len(widths)
    if ncols == 0 {
        return ""
    }
    gap2 := "  "
    lines:[str] = []
    if len(title) > 0 {
        lines = vec.push(lines, box_sanitize(title))
    }
    header := ""
    i:int = 0
    while i < ncols {
        raw := ""
        if i < len(headers) {
            raw = box_sanitize(headers[i])
        }
        header = header + box_pad_cell(raw, widths[i], box_align_at(aligns, i))
        if i + 1 < ncols {
            header = header + gap2
        }
        i = i + 1
    }
    lines = vec.push(lines, header)
    rule := ""
    i = 0
    while i < ncols {
        rule = rule + str.repeat("─", widths[i])
        if i + 1 < ncols {
            rule = rule + gap2
        }
        i = i + 1
    }
    lines = vec.push(lines, rule)
    for r in rows {
        row := ""
        i = 0
        while i < ncols {
            raw := ""
            if i < len(r) {
                raw = box_sanitize(r[i])
            }
            row = row + box_pad_cell(raw, widths[i], box_align_at(aligns, i))
            if i + 1 < ncols {
                row = row + gap2
            }
            i = i + 1
        }
        lines = vec.push(lines, row)
    }
    if len(footer) > 0 {
        lines = vec.push(lines, rule)
        row := ""
        i = 0
        while i < ncols {
            raw := ""
            if i < len(footer) {
                raw = box_sanitize(footer[i])
            }
            row = row + box_pad_cell(raw, widths[i], box_align_at(aligns, i))
            if i + 1 < ncols {
                row = row + gap2
            }
            i = i + 1
        }
        lines = vec.push(lines, row)
    }
    vec.join(lines, "\n") + "\n"
}

pub func print_table_full(t: Table, emb: Table, th: Theme, sort: str, rev: bool, boxed: bool) {
    t = sort_table(t, sort, rev)
    tot := totals(t)
    if !boxed {
        print_table_plain(t, emb, th, tot)
        return
    }
    rows:[[str]] = []
    for i in 0..len(t.langs) {
        rows = vec.push(rows, [lang_text(th, t.langs[i]), str(t.files[i]), str(t.lines[i]), str(t.code[i]), str(t.comments[i]), str(t.blanks[i])])
    }
    foot := [maybe_bold(th, apply_color(th, th.total, "Total")), maybe_bold(th, apply_color(th, th.total, str(tot[0]))), maybe_bold(th, apply_color(th, th.total, str(tot[1]))), maybe_bold(th, apply_color(th, th.total, str(tot[2]))), maybe_bold(th, apply_color(th, th.total, str(tot[3]))), maybe_bold(th, apply_color(th, th.total, str(tot[4])))]
    print(box_render(head_cells(th, ["Language", "Files", "Lines", "Code", "Comments", "Blanks"]), rows, foot, "", th.style, box_lang_aligns(6)))
    if len(emb.langs) > 0 {
        print_emb_section(emb, th, boxed)
    }
}

// Plain (unboxed) full table: the classic padded layout, default
// output. Boxed rendering lives in print_table_full above.

func print_table_plain(t: Table, emb: Table, th: Theme, tot: [int]) {
    bar := "────────────────────────────────────────────────────────────────"
    println(bar)
    h1 := pad_r("Language", 16)
    h2 := pad_l("Files", 8)
    h3 := pad_l("Lines", 10)
    h4 := pad_l("Code", 10)
    h5 := pad_l("Comments", 10)
    h6 := pad_l("Blanks", 10)
    println(maybe_bold(th, apply_color(th, th.header, "{h1}{h2}{h3}{h4}{h5}{h6}")))
    println(bar)
    for i in 0..len(t.langs) {
        lang := t.langs[i]
        show := display_name(lang)
        c1 := pad_r(show, 16)
        c2 := pad_l(str(t.files[i]), 8)
        c3 := pad_l(str(t.lines[i]), 10)
        c4 := pad_l(str(t.code[i]), 10)
        c5 := pad_l(str(t.comments[i]), 10)
        c6 := pad_l(str(t.blanks[i]), 10)
        line := "{c1}{c2}{c3}{c4}{c5}{c6}"
        if is_plain_lang(th, lang) {
            println(line)
        } else {
            println(lang_cell(th, lang, c1) + "{c2}{c3}{c4}{c5}{c6}")
        }
    }
    println(bar)
    if len(emb.langs) > 0 {
        print_emb_section(emb, th, false)
        println(bar)
    }
    tc1 := pad_r("Total", 16)
    tc2 := pad_l(str(tot[0]), 8)
    tc3 := pad_l(str(tot[1]), 10)
    tc4 := pad_l(str(tot[2]), 10)
    tc5 := pad_l(str(tot[3]), 10)
    tc6 := pad_l(str(tot[4]), 10)
    println(maybe_bold(th, apply_color(th, th.total, "{tc1}{tc2}{tc3}{tc4}{tc5}{tc6}")))
    println(bar)
}

// Languages whose bodies extract embedded child rows (Markdown fences,
// component islands, notebook cells). Single predicate so the parallel
// worker, both mergers, and tests agree.

pub func has_emb(lang: str) -> bool {
    lang == "Markdown" || lang == "Astro" || lang == "Vue" || lang == "Svelte" || lang == "Mdx" || lang == "Jupyter"
}

// Drop one language's rows (for --no-generated). Totals recompute
// downstream, so the table stays balanced.

pub func filter_lang(t: Table, drop: str) -> Table {
    out := new_table()
    for i in 0..len(t.langs) {
        if t.langs[i] == drop {
            continue
        }
        out = add_row(out, t.langs[i], t.files[i], t.lines[i], t.code[i], t.comments[i], t.blanks[i])
    }
    out
}

// Display prefix ("└ Rust") back to the language name for override
// lookup. Byte-safe: splits on ASCII space, never slices multibyte.

pub func emb_base_lang(lang: str) -> str {
    if str.starts_with(lang, "└ ") {
        parts := str.split(lang, " ")
        if len(parts) > 1 {
            return parts[1]
        }
    }
    lang
}

// Indices of the top-n rows by lines, descending. Partial pick-max:
// O(n*k) scans, no full sort (n files, k shown).

pub func top_by_lines(lines: [int], n: int) -> [int] {
    out := []
    if n <= 0 || len(lines) == 0 {
        return out
    }
    used := []
    for _x in lines {
        used = vec.push(used, 0)
    }
    count := n
    if count > len(lines) {
        count = len(lines)
    }
    for _k in 0..count {
        best := -1
        for i in 0..len(lines) {
            if used[i] == 1 {
                continue
            }
            if best == -1 || lines[i] > lines[best] {
                best = i
            }
        }
        if best == -1 {
            break
        }
        used[best] = 1
        out = vec.push(out, best)
    }
    out
}

// Display path: trim to 44 columns with leading "..." (byte-safe: ASCII
// dots + tail slice; paths are overwhelmingly ASCII, worst case a cut
// multibyte char degrades one glyph, never errors).

pub func display_path(p: str) -> str {
    if len(p) <= 44 {
        return p
    }
    "..." + p[len(p) - 41:len(p)]
}

pub func print_files_section(root: str, paths: [str], langs: [str], lines: [int], code: [int], comments: [int], blanks: [int], topn: int, th: Theme, boxed: bool) {
    idx := top_by_lines(lines, topn)
    if len(idx) == 0 {
        return
    }
    shown := len(idx)
    if !boxed {
        print_files_plain(root, paths, langs, lines, code, comments, blanks, idx, shown, th)
        return
    }
    rows:[[str]] = []
    for k in idx {
        rel := paths[k]
        prefix := root + "/"
        if str.starts_with(rel, prefix) {
            rel = rel[len(prefix):len(rel)]
        }
        rows = vec.push(rows, [display_path(rel), lang_text(th, langs[k]), str(lines[k]), str(code[k]), str(comments[k]), str(blanks[k])])
    }
    print(box_render(head_cells(th, ["File", "Language", "Lines", "Code", "Comments", "Blanks"]), rows, [], "Top {shown} files by lines", th.style, box_file_aligns(6)))
}

func print_files_plain(root: str, paths: [str], langs: [str], lines: [int], code: [int], comments: [int], blanks: [int], idx: [int], shown: int, th: Theme) {
    println("")
    println(" Top {shown} files by lines")
    f0 := pad_r("File", 44)
    f1 := pad_r("Language", 12)
    f2 := pad_l("Lines", 10)
    f3 := pad_l("Code", 10)
    f4 := pad_l("Comments", 10)
    f5 := pad_l("Blanks", 10)
    println(maybe_bold(th, apply_color(th, th.header, "{f0}{f1}{f2}{f3}{f4}{f5}")))
    for k in idx {
        rel := paths[k]
        prefix := root + "/"
        if str.starts_with(rel, prefix) {
            rel = rel[len(prefix):len(rel)]
        }
        c0 := pad_r(display_path(rel), 44)
        c1 := pad_r(display_name(langs[k]), 12)
        c2 := pad_l(str(lines[k]), 10)
        c3 := pad_l(str(code[k]), 10)
        c4 := pad_l(str(comments[k]), 10)
        c5 := pad_l(str(blanks[k]), 10)
        line := "{c0}{c1}{c2}{c3}{c4}{c5}"
        if is_plain_lang(th, langs[k]) {
            println(line)
        } else {
            println(c0 + lang_cell(th, langs[k], c1) + "{c2}{c3}{c4}{c5}")
        }
    }
}

pub func print_emb_section(emb: Table, th: Theme, boxed: bool) {
    if len(emb.langs) == 0 {
        return
    }
    // aggregate embedded
    t := new_table()
    for i in 0..len(emb.langs) {
        t = add_row(t, emb.langs[i], emb.files[i], emb.lines[i], emb.code[i], emb.comments[i], emb.blanks[i])
    }
    t = sort_table(t, "code", false)
    if !boxed {
        print_emb_plain(t, th)
        return
    }
    rows:[[str]] = []
    for i in 0..len(t.langs) {
        lang := emb_base_lang(t.langs[i])
        // section rows follow per-language overrides, else the default
        // language hue (never plain: the section is opt-in detail).
        // dimmed to set the section apart from the main table.
        spec := theme_lang_color(th, lang)
        if spec == "" {
            spec = th.language
        }
        c1 := display_name(lang)
        if th.color {
            c1 = colors.dim(maybe_bold(th, apply_color(th, spec, c1)))
        }
        rows = vec.push(rows, [c1, str(t.files[i]), str(t.lines[i]), str(t.code[i]), str(t.comments[i]), str(t.blanks[i])])
    }
    tot := totals(t)
    foot := [maybe_bold(th, apply_color(th, th.total, "Total")), str(tot[0]), str(tot[1]), str(tot[2]), str(tot[3]), str(tot[4])]
    print(box_render(head_cells(th, ["Language", "Files", "Lines", "Code", "Comments", "Blanks"]), rows, foot, "Embedded code", th.style, box_lang_aligns(6)))
}

func print_emb_plain(t: Table, th: Theme) {
    println(maybe_bold(th, apply_color(th, th.header, "Embedded code")))
    for i in 0..len(t.langs) {
        lang := emb_base_lang(t.langs[i])
        c1 := pad_r(" " + display_name(lang), 16)
        c2 := pad_l(str(t.files[i]), 8)
        c3 := pad_l(str(t.lines[i]), 10)
        c4 := pad_l(str(t.code[i]), 10)
        c5 := pad_l(str(t.comments[i]), 10)
        c6 := pad_l(str(t.blanks[i]), 10)
        line := "{c1}{c2}{c3}{c4}{c5}{c6}"
        spec := theme_lang_color(th, lang)
        if spec == "" {
            spec = th.language
        }
        if th.color {
            println(colors.dim(maybe_bold(th, apply_color(th, spec, c1))) + "{c2}{c3}{c4}{c5}{c6}")
        } else {
            println(line)
        }
    }
    tot := totals(t)
    // "└" is 1 column: pad to the same 16 the data rows use (len()
    // counts chars, so no byte over-padding).
    c1 := pad_r(" └ (Total)", 16)
    c2 := pad_l(str(tot[0]), 8)
    c3 := pad_l(str(tot[1]), 10)
    c4 := pad_l(str(tot[2]), 10)
    c5 := pad_l(str(tot[3]), 10)
    c6 := pad_l(str(tot[4]), 10)
    println("{c1}{c2}{c3}{c4}{c5}{c6}")
}

// JSON export (--output json). Manual build for full control.

pub func escape_json(s: str) -> str {
    e := str.replace(s, "\\", "\\\\")
    e = str.replace(e, "\"", "\\\"")
    e = str.replace(e, "\n", "\\n")
    e
}

pub func to_json(t: Table, emb: Table) -> str {
    "{" + json_tables(t) + json_emb(emb) + "}"
}

// Same document plus a top-n files array (for --by-file).

pub func to_json_full(t: Table, emb: Table, paths: [str], langs: [str], lines: [int], code: [int], comments: [int], blanks: [int], topn: int) -> str {
    out:str = "{" + json_tables(t) + json_emb(emb)
    idx := top_by_lines(lines, topn)
    out = out + ",\"files\":["
    first:bool = true
    for k in idx {
        if !first {
            out = out + ","
        }
        first = false
        p := escape_json(paths[k])
        lg := escape_json(langs[k])
        out = out + "{\"path\":\"{p}\",\"language\":\"{lg}\",\"lines\":{lines[k]},\"code\":{code[k]},\"comments\":{comments[k]},\"blanks\":{blanks[k]}}"
    }
    out = out + "]}"
    out
}

func json_tables(t: Table) -> str {
    t = sort_table(t, "code", false)
    tot := totals(t)
    // NOTE: explicit annotations — the AOT inferencer once resolved `out`
    // as bool here (order-dependent; printed "false"). Pinned until the
    // upstream inference bug is fixed.
    out:str = "\"languages\":{"
    first:bool = true
    for i in 0..len(t.langs) {
        if !first {
            out = out + ","
        }
        first = false
        lang := escape_json(t.langs[i])
        out = out + "\"{lang}\":{\"files\":{t.files[i]},\"lines\":{t.lines[i]},\"code\":{t.code[i]},\"comments\":{t.comments[i]},\"blanks\":{t.blanks[i]}}"
    }
    out = out + "},\"total\":{\"files\":{tot[0]},\"lines\":{tot[1]},\"code\":{tot[2]},\"comments\":{tot[3]},\"blanks\":{tot[4]}}"
    out
}

func json_emb(emb: Table) -> str {
    t := new_table()
    for i in 0..len(emb.langs) {
        t = add_row(t, emb_base_lang(emb.langs[i]), emb.files[i], emb.lines[i], emb.code[i], emb.comments[i], emb.blanks[i])
    }
    t = sort_table(t, "code", false)
    out:str = ",\"embedded\":{"
    first:bool = true
    for i in 0..len(t.langs) {
        if !first {
            out = out + ","
        }
        first = false
        lang := escape_json(t.langs[i])
        out = out + "\"{lang}\":{\"files\":{t.files[i]},\"lines\":{t.lines[i]},\"code\":{t.code[i]},\"comments\":{t.comments[i]},\"blanks\":{t.blanks[i]}}"
    }
    out = out + "}"
    out
}
