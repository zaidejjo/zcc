// zcc/src/parallel.zz — parallel fan-out for cold recounts.
//
// Design (green threads, snapshot isolation):
// - The main thread does walk + ext-map resolve + cache lookup (cheap,
//   serial, zero big copies). Only cache MISSES fan out to workers.
// - Each worker gets plain range data (paths/langs/shows + pre-resolved
//   marker strings) and returns plain per-file counts. The opaque json
//   language table never crosses the spawn boundary (it is not
//   snapshot-safe); only [str]/[int] do.
// - Workers read their own files: passing bodies in would deep-copy every
//   byte across the spawn boundary, while paths are tiny. Blocking file
//   IO parks an executor thread and the pool tops itself up, so parallel
//   cold reads still win; warm runs (all cache hits) never spawn at all.
// - Results merge in chunk order, so --by-file and cache rows keep walk
//   order and output is deterministic run to run.
// - No fail()/println() inside workers (AOT lowers task panics to unit):
//   unreadable/binary files return oks[i] == 0 and the merger skips them,
//   exactly like the serial `continue`.
import std.fs
import std.str
import std.vec

import counter
import walker

// Per-file results for one chunk, in chunk order.

pub struct ChunkOut {
    lines: [int],
    code: [int],
    comments: [int],
    blanks: [int],
    fencs: [str],
    oks: [int],
    gens: [int],
}

// Cross-module constructor (struct literals are same-module only).

pub func new_chunk_out(lines: [int], code: [int], comments: [int], blanks: [int], fencs: [str], oks: [int], gens: [int]) -> ChunkOut {
    ChunkOut{lines: lines, code: code, comments: comments, blanks: blanks, fencs: fencs, oks: oks, gens: gens}
}

// Cold runs below this many misses stay serial: spawn + snapshot costs
// more than it saves on tiny trees (startup floor dominates there).

pub func par_threshold() -> int {
    32
}

// Worker count clamp: green threads multiplex onto one OS thread per
// CPU, so more workers than ~2x cores just adds stealing overhead.

pub func worker_cap() -> int {
    8
}

// "" -> no markers (keeps the counter's no-comment fast path);
// otherwise the \x01-joined marker list from the main thread.

pub func split_markers(mj: str) -> [str] {
    out:[str] = []
    if mj == "" {
        return out
    }
    str.split(mj, "\x01")
}

// Serial worker body over paths[start..end]. Pure function of its args:
// same inputs as the old serial loop give byte-identical outputs.

pub func count_files(paths: [str], langs: [str], shows: [str], mjoined: [str], bstarts: [str], bends: [str], start: int, end: int) -> ChunkOut {
    lines := []
    code := []
    comments := []
    blanks := []
    fencs := []
    oks := []
    gens := []
    for i in start..end {
        markers := split_markers(mjoined[i])
        // Fused fast path for plain langs: one scan call replaces
        // read + NUL check + classify. Embed-capable langs keep the
        // text path below (their ZZ loops disagree with raw classify),
        // and the Generated path needs no text at all (counts in hand,
        // embeds dropped by the merger).
        emb := langs[i] == "Markdown" || langs[i] == "Mdx" || langs[i] == "Astro" || langs[i] == "Vue" || langs[i] == "Svelte" || langs[i] == "Jupyter"
        if !emb {
            r := counter.scan_file(paths[i], langs[i], markers, bstarts[i], bends[i])
            if r[0] < 0 || r[4] == 1 {
                lines = vec.push(lines, 0)
                code = vec.push(code, 0)
                comments = vec.push(comments, 0)
                blanks = vec.push(blanks, 0)
                fencs = vec.push(fencs, "")
                oks = vec.push(oks, 0)
                gens = vec.push(gens, 0)
                continue
            }
            if shows[i] != langs[i] {
                lines = vec.push(lines, r[0])
                code = vec.push(code, r[1])
                comments = vec.push(comments, r[2])
                blanks = vec.push(blanks, r[3])
                fencs = vec.push(fencs, "")
                oks = vec.push(oks, 1)
                gens = vec.push(gens, 0)
                continue
            }
            // Fused generated check: one path-only call, no text crossing
            // (the file was just read cache-hot by the scan above; an
            // unreadable race skips exactly like a read error did, and
            // counts always come from the scan snapshot).
            g := counter.is_generated_file(paths[i])
            if g < 0 {
                lines = vec.push(lines, 0)
                code = vec.push(code, 0)
                comments = vec.push(comments, 0)
                blanks = vec.push(blanks, 0)
                fencs = vec.push(fencs, "")
                oks = vec.push(oks, 0)
                gens = vec.push(gens, 0)
                continue
            }
            gen := 0
            if g == 1 {
                gen = 1
            }
            lines = vec.push(lines, r[0])
            code = vec.push(code, r[1])
            comments = vec.push(comments, r[2])
            blanks = vec.push(blanks, r[3])
            fencs = vec.push(fencs, "")
            oks = vec.push(oks, 1)
            gens = vec.push(gens, gen)
            continue
        }
        match fs.read_to_string(paths[i]) {
            .ok(text) => {
                if walker.has_nul(text) {
                    lines = vec.push(lines, 0)
                    code = vec.push(code, 0)
                    comments = vec.push(comments, 0)
                    blanks = vec.push(blanks, 0)
                    fencs = vec.push(fencs, "")
                    oks = vec.push(oks, 0)
                    gens = vec.push(gens, 0)
                    continue
                }
                gen := 0
                if shows[i] == langs[i] {
                    g := counter.is_generated_file(paths[i])
                    if g < 0 {
                        lines = vec.push(lines, 0)
                        code = vec.push(code, 0)
                        comments = vec.push(comments, 0)
                        blanks = vec.push(blanks, 0)
                        fencs = vec.push(fencs, "")
                        oks = vec.push(oks, 0)
                        gens = vec.push(gens, 0)
                        continue
                    }
                    if g == 1 {
                        gen = 1
                    }
                }
                c := counter.count_content_with(text, langs[i], markers, bstarts[i], bends[i])
                lines = vec.push(lines, c.lines)
                code = vec.push(code, c.code)
                comments = vec.push(comments, c.comments)
                blanks = vec.push(blanks, c.blanks)
                // Embedded extraction only for emb-capable langs on the
                // non-Generated path (the merger drops fenc when
                // show != lang, so Generated-path files skip the
                // split + recount entirely; plain langs skip after
                // the outer compares).
                fenc := ""
                if langs[i] == "Markdown" || langs[i] == "Mdx" || langs[i] == "Astro" || langs[i] == "Vue" || langs[i] == "Svelte" || langs[i] == "Jupyter" {
                    if shows[i] == langs[i] {
                        if langs[i] == "Markdown" || langs[i] == "Mdx" {
                            fenc = fence_enc(text)
                            noop()
                        }
                        if langs[i] == "Astro" {
                            fenc = astro_enc(text)
                            noop()
                        }
                        if langs[i] == "Vue" || langs[i] == "Svelte" {
                            fenc = island_enc(text, false)
                            noop()
                        }
                        if langs[i] == "Jupyter" {
                            fenc = notebook_enc(text)
                            noop()
                        }
                    }
                }
                fencs = vec.push(fencs, fenc)
                oks = vec.push(oks, 1)
                gens = vec.push(gens, gen)
            }
            .err(_) => {
                lines = vec.push(lines, 0)
                code = vec.push(code, 0)
                comments = vec.push(comments, 0)
                blanks = vec.push(blanks, 0)
                fencs = vec.push(fencs, "")
                oks = vec.push(oks, 0)
                gens = vec.push(gens, 0)
            }
        }
    }
    new_chunk_out(lines, code, comments, blanks, fencs, oks, gens)
}

func noop() {
    
    
}

// Astro island rows for one body (same enc protocol as fence_enc;
// files-with-islands, not island spans).

pub func astro_enc(text: str) -> str {
    island_enc(text, true)
}

pub func island_enc(text: str, front: bool) -> str {
    rows := []
    embeds := counter.island_embeds(text, front)
    if len(embeds) != 2 {
        return ""
    }
    lang_part := embeds[0]
    body_part := embeds[1]
    if lang_part == "" {
        return ""
    }
    llist := str.split(lang_part, "\x01")
    blist := str.split(body_part, "\x02")
    agg_lang := []
    agg_lines := []
    agg_code := []
    agg_comments := []
    agg_blanks := []
    for i in 0..len(llist) {
        tag := llist[i]
        if tag == "" {
            continue
        }
        body := ""
        if i < len(blist) {
            body = blist[i]
        }
        ec := counter.count_content(body, tag)
        if languages.is_one_of(tag, ["Yaml", "Css", "TypeScript", "JavaScript"]) {
            hit := -1
            for q in 0..len(agg_lang) {
                if agg_lang[q] == tag {
                    hit = q
                    break
                }
            }
            if hit < 0 {
                agg_lang = vec.push(agg_lang, tag)
                agg_lines = vec.push(agg_lines, ec.lines)
                agg_code = vec.push(agg_code, ec.code)
                agg_comments = vec.push(agg_comments, ec.comments)
                agg_blanks = vec.push(agg_blanks, ec.blanks)
            } else {
                agg_lines[hit] = agg_lines[hit] + ec.lines
                agg_code[hit] = agg_code[hit] + ec.code
                agg_comments[hit] = agg_comments[hit] + ec.comments
                agg_blanks[hit] = agg_blanks[hit] + ec.blanks
            }
        }
    }
    rows = []
    for q in 0..len(agg_lang) {
        rows = vec.push(rows, "└ {agg_lang[q]}\x1f1\x1f{agg_lines[q]}\x1f{agg_code[q]}\x1f{agg_comments[q]}\x1f{agg_blanks[q]}")
    }
    str.join(rows, "\x1e")
}

pub func notebook_enc(text: str) -> str {
    body := counter.notebook_source(text)
    if body == "" {
        return ""
    }
    ec := counter.count_content(body, "Python")
    "└ Python\x1f1\x1f{ec.lines}\x1f{ec.code}\x1f{ec.comments}\x1f{ec.blanks}"
}

// Extract fenced-code rows from one Markdown body as a raw emb
// encoding (rows joined by \x1e, "" when none). Moved here from main.zz
// so workers compute it without calling back across the boundary.

pub func fence_enc(text: str) -> str {
    rows := []
    fenced := counter.markdown_fences(text)
    if len(fenced) != 2 {
        return ""
    }
    lang_part := fenced[0]
    body_part := fenced[1]
    if lang_part == "" {
        return ""
    }
    llist := str.split(lang_part, "\x01")
    blist := str.split(body_part, "\x02")
    // Aggregate same-language blocks within this file: Files counts
    // files-with-fences (tokei parity), not fence blocks.
    agg_lang := []
    agg_lines := []
    agg_code := []
    agg_comments := []
    agg_blanks := []
    for i in 0..len(llist) {
        tag := llist[i]
        if tag == "" {
            continue
        }
        body := ""
        if i < len(blist) {
            body = blist[i]
        }
        disp := tag
        ec := counter.count_content(body, disp)
        if languages.is_one_of(disp, ["BASH", "Rust", "Python", "TOML", "Lua", "JavaScript", "TypeScript", "Astro", "ZZ", "Yaml"]) {
            hit := -1
            for q in 0..len(agg_lang) {
                if agg_lang[q] == disp {
                    hit = q
                    break
                }
            }
            if hit < 0 {
                agg_lang = vec.push(agg_lang, disp)
                agg_lines = vec.push(agg_lines, ec.lines)
                agg_code = vec.push(agg_code, ec.code)
                agg_comments = vec.push(agg_comments, ec.comments)
                agg_blanks = vec.push(agg_blanks, ec.blanks)
            } else {
                agg_lines[hit] = agg_lines[hit] + ec.lines
                agg_code[hit] = agg_code[hit] + ec.code
                agg_comments[hit] = agg_comments[hit] + ec.comments
                agg_blanks[hit] = agg_blanks[hit] + ec.blanks
            }
        }
    }
    rows = []
    for q in 0..len(agg_lang) {
        rows = vec.push(rows, "└ {agg_lang[q]}\x1f1\x1f{agg_lines[q]}\x1f{agg_code[q]}\x1f{agg_comments[q]}\x1f{agg_blanks[q]}")
    }
    str.join(rows, "\x1e")
}
