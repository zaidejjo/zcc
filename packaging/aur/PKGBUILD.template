# Maintainer: zaidejjo
# Generated by zcc's release workflow from PKGBUILD.template — do not edit
# in the AUR repo directly; change the template and cut a new release.
pkgname=zcc
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Blazing-fast code counter (tokei clone) written in ZZ'
arch=('x86_64')
url='https://github.com/zaidejjo/zcc'
license=('MIT')
depends=('glibc')
makedepends=('cargo' 'clang' 'git')
# The ZZ toolchain source is pinned by commit (see packaging/zz.rev in the
# zcc repo); its hash is intentionally SKIP — the rev is the version.
source=("zcc-$pkgver-src.tar.gz::$url/releases/download/v$pkgver/zcc-$pkgver-src.tar.gz"
        "zz-@_ZZ_REV@.tar.gz::https://github.com/zaidejjo/zz/archive/@_ZZ_REV@.tar.gz")
sha256sums=('@SHA256@'
            'SKIP')

build() {
  # 1. ZZ toolchain from pinned source.
  cd "$srcdir/zz-@_ZZ_REV@"
  cargo install --path crates/zz_cli --root "$srcdir/zz-toolchain"
  export PATH="$srcdir/zz-toolchain/bin:$PATH"
  # 2. Stamp the release version (source tarball carries the tag tree).
  cd "$srcdir/zcc-$pkgver"
  sed -i "s/^    \"0\.1\.0\"$/    \"$pkgver\"/" src/main.zz
  sed -i "s/^version = \"0\.1\.0\"$/version = \"$pkgver\"/" zz.toml
  # 3. Native release binary.
  zz build -p src/main.zz
}

package() {
  cd "$srcdir/zcc-$pkgver"
  install -Dm755 src/bin/main "$pkgdir/usr/bin/zcc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 config.example.json "$pkgdir/usr/share/doc/$pkgname/config.example.json"
  install -Dm644 config.example-zz.json "$pkgdir/usr/share/doc/$pkgname/config.example-zz.json"
}
